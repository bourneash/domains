# Security Dashboard V2 - Environment Variables
# Copy this file to .env and fill in your values.

# Instance identity — MUST be unique per installation
# Used for container names, networks, volumes. Cannot be changed after install.
INSTANCE_NAME=vitae-v2

# PostgreSQL
POSTGRES_USER=vitae_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vitae_v2
POSTGRES_URL=postgresql+asyncpg://vitae_user:CHANGE_ME@vitae-v2-db:5432/vitae_v2

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@vitae-v2-redis:6379/0

# SonarQube (server runs via `docker compose --profile sonarqube up -d sonarqube`)
SONARQUBE_URL=http://vitae-v2-sonarqube:9000
SONARQUBE_ADMIN_USER=admin
SONARQUBE_ADMIN_PASSWORD=CHANGE_ME
SONAR_JDBC_URL=jdbc:postgresql://vitae-v2-db:5432/sonarqube
SONAR_JDBC_USERNAME=vitae_user
SONAR_JDBC_PASSWORD=CHANGE_ME

# NVD API Key (for OWASP Dependency Check)
NVD_API_KEY=CHANGE_ME

# Host paths for Docker-in-Docker volume mounts (must be absolute)
# These default to ${PWD}/... in docker-compose, but can be overridden here.
# HOST_TEMP_SCANS_PATH=/path/to/security_v2/temp-scans
# HOST_BACKEND_PATH=/path/to/security_v2/backend

# JWT (must change in production!)
JWT_SECRET=CHANGE_ME

# --- Portability Settings (optional, all have sensible defaults) ---

# Exposed ports (change if these conflict with other services)
# API_PORT=8890
# FRONTEND_PORT=8891
# SONARQUBE_PORT=9001

# CORS allowed origins (comma-separated, no spaces)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8891

# Container name prefix (useful for running multiple instances)
# CONTAINER_PREFIX=vitae-v2

# Docker network for scanner containers (must match docker-compose network name)
# SCANNER_NETWORK=vitae-v2-executor-net
