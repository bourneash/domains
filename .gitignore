# Parent .gitignore — applies to all repos rooted under /home/jesse/projects/domains/
# Individual repos also have their own .gitignore; this is belt-and-suspenders for secrets.

# Secrets
.env
.env.shared
.gcp/
.env.local
.env.*.local
*.pem
*.key
.cloudflared/

# Tooling artifacts at repo root
.worktrees/
.playwright-mcp/
playwright-report/
test-results/
.claude/settings.local.json
.cloak-screenshots/
node_modules/

# Stray screenshots dropped at root by browser sessions
/*.png
/*.jpg
/*.jpeg

# OS cruft
.DS_Store
Thumbs.db

.security-dashboard/
.vsec
SecurityScanner/.runtime/

# Disabled sites (renamed out of the active roster)
sites/DISABLED-*/

# Python build/cache artefacts (never sweep these in via git add -A)
__pycache__/
*.egg-info/
*.pyc

# Cron/script run logs (never sweep these in via git add -A)
tools/scripts/*.log
tools/scripts/*.lock
tools/scripts/.ensure-fleet-cron-alerts/
tools/scripts/.check-claude-auth-state
tools/scripts/.check-claude-auth-alerted
tools/scripts/.dd-auth-state/
# Scheduler-freshness watchdogs: alert cooldown stamps and the rolling
# restart-tracking state. Runtime state, not source.
tools/scripts/.cron-freshness.last-alert
tools/scripts/.fleet-cron-freshness.state
tools/scripts/.fleet-cron-freshness.state.alert
tools/scripts/.fleet-cron-host-watchdog.alerted
# The host-side fleet-cron watchdog's heartbeat. Its MTIME is the signal that
# fleet-cron job 16 asserts, so it is rewritten every 15 minutes — committing
# it would put a churning file in every diff for no gain.
tools/fleet-cron/.host-freshness-report

# Fleet lint sweep — run artifacts, not source. latest.json changes on every
# sweep and history.jsonl grows forever; both are host state.
tools/lint-fleet/*.log
tools/lint-fleet/*.log.1
tools/lint-fleet/.lint-sweep.lock
tools/lint-fleet/reports/
.aider*

# fleet-registry runtime state
tools/fleet-registry/drift.log
tools/fleet-registry/drift.log.1
tools/fleet-registry/.drift.lock
tools/fleet-registry/.drift-state.json
Findings-*.md

# Fleet-level AI ledger written by tools/ai-optimizer's roles (CRON_SITE=_fleet).
# Runtime data, same convention every site uses for its own ops/logs/*.
ops/logs/*
!ops/logs/.gitkeep

# Design-review screenshots that land at the repo root during a site build.
# `/*.png` below already keeps them out of git; this is the parking spot for
# ones nothing has touched in a week, so the root stays legible while an
# in-flight design session keeps writing fresh ones (B14, 2026-08-25).
# Nothing reads from here — delete it whenever.
.screenshots-archive/
**/__pycache__/**
**/.wrangler/**
