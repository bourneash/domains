# Copy this file to .env and fill in your values.
# .env is gitignored — never commit the real file.

# Cloudflare — used by cf-stats, all deploy scripts, and domain ops
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare R2 over the S3 API — for host-side scripts that read/write a
# bucket directly. Workers do NOT need these: an in-worker binding
# (`r2_buckets` in wrangler.jsonc, e.g. vibratorporn's CRAWL_ARCHIVE) is
# credential-free. Note the spelling: the live .env carried
# CF_SECRETE_ACCESS_KEY until 2026-08-25, so anything written against the
# correct name silently read empty and only failed at call time (B13).
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_S3_API_ENDPOINT=

# Image APIs — used by content-writer roles for editorial images
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_APPLICATION_ID=
UNSPLASH_SECRET_KEY=

# Affiliate / partner APIs (add as you onboard new programs)
# AMAZON_ASSOCIATE_TAG=
# IMPACT_ACCOUNT_SID=
# IMPACT_AUTH_TOKEN=
