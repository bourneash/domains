# VPN Proxy — add these to /home/jesse/projects/domains/.env
#
# PIA credentials: your account username + password (same as pia.com login)
# OpenVPN username is your PIA account p-number (e.g. p1234567)
VPN_PIA_USERNAME=
VPN_PIA_PASSWORD=

# PIA region names — full list: https://www.privateinternetaccess.com/pages/network/
# Common US options:  US East | US West | US Silicon Valley | US Chicago
# Common EU options:  Netherlands | Germany | France | Sweden
VPN_REGION_US=US East
VPN_REGION_EU=Netherlands
