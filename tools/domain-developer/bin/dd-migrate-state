#!/usr/bin/env bash
# dd-migrate-state [site]
#
# One-time, COPY-ONLY migration of per-site Claude state from the legacy named
# volumes (dd-claude-<site>, dd-home-<site>) to host bind dirs under
# tools/domain-developer/state/<site>/{claude,persist}.
#
# Safety:
#   - Copy-only, NO-CLOBBER (cp -an): never overwrites newer host files, never
#     deletes from the volume. Idempotent — safe to re-run.
#   - Leaves the named volumes intact as a backup. Prune them yourself only
#     after dd-doctor passes and the recreated sites work:
#         docker volume rm dd-claude-<site> dd-home-<site>
#
# Run with no arg to migrate every site that still has a legacy claude volume.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_ROOT="${DD_STATE_DIR:-${HERE}/../state}"
OWNER="$(id -u):$(id -g)"
mkdir -p "${STATE_ROOT}"

copy_volume() {
    local vol="$1" dest="$2" label="$3"
    if ! docker volume inspect "${vol}" >/dev/null 2>&1; then
        echo "  [${label}] no volume '${vol}' — skip"
        return 0
    fi
    mkdir -p "${dest}"
    echo "  [${label}] ${vol} -> ${dest}  (copy-only, no-clobber)"
    # Throwaway container reads the volume RO and writes the host dir, then
    # chowns to the host uid so the worker's dev user (uid 1000) owns it.
    docker run --rm \
        -v "${vol}:/from:ro" \
        -v "${dest}:/to" \
        alpine sh -c "cp -an /from/. /to/ 2>/dev/null || true; chown -R ${OWNER} /to"
}

migrate_one() {
    local site="$1"
    copy_volume "dd-claude-${site}" "${STATE_ROOT}/${site}/claude"   "${site}/claude"
    copy_volume "dd-home-${site//[^a-zA-Z0-9_.-]/_}" "${STATE_ROOT}/${site}/persist" "${site}/persist"
}

if [[ $# -ge 1 ]]; then
    echo "site: $1"
    migrate_one "$1"
else
    docker volume ls --format '{{.Name}}' \
        | grep '^dd-claude-' | sed 's/^dd-claude-//' | sort \
        | while read -r s; do
            echo "site: ${s}"
            migrate_one "${s}"
        done
fi

echo "done. Legacy volumes left intact as backup."
