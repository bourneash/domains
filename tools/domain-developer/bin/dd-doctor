#!/usr/bin/env bash
# dd-doctor [site]
#
# Verifies a domain-developer worker container against the durability redesign
# (tools/domain-developer/REDESIGN.md). Doubles as the executable spec and the
# rollout gate: run it after recreating a site to confirm the fixes took.
#
# Checks per container:
#   1. .credentials.json is NOT bound read-only at its destination
#      (it must be a writable copy so OAuth refresh can persist)        [RC1]
#   2. credentials file is actually writable inside the container        [RC1]
#   3. /home/dev/.claude is a HOST BIND (not a named volume)             [RC2]
#   4. /home/dev/persist is a HOST BIND (not a named volume)             [RC2]
#   5. tmux is installed in the image (session survives a bounce)        [RC2]
#   6. NO restart policy — a worker must never resurrect itself         [CATTLE]
#   7. container is RUNNING — a stopped dd-* container is a pet that
#      pins its creation-time image; the reaper should have removed it  [CATTLE]
#   8. running image == domain-developer:latest — a worker created
#      before the last dd-build is silently on stale code              [CATTLE]
#
# CATTLE checks correspond to the cattle-not-pets model: worker containers are
# disposable, never resurrected, never outlive their session. See
# tools/scripts/reap-idle-dd-workers.sh's header for the full three-part fix
# (create path, reaper, this verifier).
#
# Exit 0 only if every checked container passes every check.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_REPO="$(cd "${HERE}/../../.." && pwd)"

IMAGE="${DD_IMAGE:-domain-developer:latest}"
WANT_IMAGE_ID="$(docker image inspect --format '{{.Id}}' "${IMAGE}" 2>/dev/null || true)"

pass=0; fail=0
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; fail=$((fail+1)); }
note() { printf '    \033[2m%s\033[0m\n' "$1"; }

containers() {
    if [[ $# -ge 1 && -n "${1:-}" ]]; then
        echo "dd-$1"
    else
        docker ps -a --filter 'name=^dd-' --format '{{.Names}}' | grep -v '^dd-panel$' || true
    fi
}

check_one() {
    local c="$1"
    printf '\n\033[1m%s\033[0m\n' "$c"
    if ! docker inspect "$c" >/dev/null 2>&1; then
        bad "container does not exist"; return
    fi
    local running; running="$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)"

    # 1. credentials must NOT be a RO bind at the destination path
    local cred_rw
    cred_rw="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/home/dev/.claude/.credentials.json"}}{{.RW}}{{end}}{{end}}' "$c" 2>/dev/null)"
    if [[ -z "${cred_rw}" ]]; then
        ok "credentials.json not bind-mounted at destination (copied-in copy)"
    elif [[ "${cred_rw}" == "false" ]]; then
        bad "credentials.json is RO bind-mounted at destination → OAuth refresh will fail"
        note "recreate this container after dd-build to pick up the writable-creds fix"
    else
        ok "credentials.json bind is writable"
    fi

    # 2. credentials writable inside the container (only if running)
    if [[ "${running}" == "true" ]]; then
        if docker exec "$c" test -w /home/dev/.claude/.credentials.json 2>/dev/null; then
            ok "credentials.json is writable inside the container"
        elif docker exec "$c" test -e /home/dev/.claude/.credentials.json 2>/dev/null; then
            bad "credentials.json exists but is NOT writable inside the container"
        else
            note "credentials.json not present yet (first boot may not have copied it)"
        fi
    fi

    # 3. .claude must be a host bind, not a named volume
    local claude_src
    claude_src="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/home/dev/.claude"}}{{.Type}}:{{.Source}}{{end}}{{end}}' "$c" 2>/dev/null)"
    case "${claude_src}" in
        bind:*) ok ".claude is a host bind (${claude_src#bind:})" ;;
        volume:*) bad ".claude is a named VOLUME → not prune-proof/visible (${claude_src#volume:})" ;;
        *) note ".claude mount: ${claude_src:-<none>}" ;;
    esac

    # 4. persist must be a host bind, not a named volume
    local persist_src
    persist_src="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/home/dev/persist"}}{{.Type}}:{{.Source}}{{end}}{{end}}' "$c" 2>/dev/null)"
    case "${persist_src}" in
        bind:*) ok "persist is a host bind" ;;
        volume:*) bad "persist is a named VOLUME (${persist_src#volume:})" ;;
        *) note "persist mount: ${persist_src:-<none>}" ;;
    esac

    # 5. tmux present in image
    if [[ "${running}" == "true" ]]; then
        if docker exec "$c" sh -c 'command -v tmux' >/dev/null 2>&1; then
            ok "tmux present (session survives a bounce)"
        else
            bad "tmux NOT installed → REPL dies when the container bounces"
        fi
    fi

    # 6. no restart policy [CATTLE]. `unless-stopped` is what made these
    #    containers immortal: they came back after every daemon/host restart
    #    whether or not anyone wanted them, so the fleet accumulated workers
    #    nobody had deliberately started.
    local rpol
    rpol="$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$c" 2>/dev/null)"
    case "${rpol}" in
        ''|no) ok "no restart policy (worker cannot resurrect itself)" ;;
        *) bad "restart policy is '${rpol}' → this worker is a pet, it comes back on its own"
           note "recreate it: ${HERE}/dd-recreate ${c#dd-}" ;;
    esac

    # 7. must be running [CATTLE]. A stopped-but-present dd-* container pins
    #    the image it was created from, so a later dd-build can never reach
    #    it. Both entry points now destroy rather than `docker start` such a
    #    container, and the reaper sweeps corpses — so finding one here means
    #    either the reaper is broken or something is creating them by hand.
    if [[ "${running}" == "true" ]]; then
        ok "running (no parked container object)"
    else
        local st; st="$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null)"
        bad "container exists but is '${st}' → a parked pet pinning a stale image"
        note "remove it: docker rm ${c}   (state lives on host binds, nothing is lost)"
        note "if this keeps reappearing, check tools/scripts/reap-idle-dd-workers.sh is running (crontab.docker job 9)"
    fi

    # 8. image freshness [CATTLE]. The one pet the model can still produce is
    #    a LONG-lived active session started before the most recent dd-build.
    #    Never auto-killed; must never be silent either.
    if [[ -n "${WANT_IMAGE_ID}" ]]; then
        local have_id; have_id="$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null)"
        if [[ "${have_id}" == "${WANT_IMAGE_ID}" ]]; then
            ok "running the current ${IMAGE}"
        else
            bad "running an OLDER image than ${IMAGE} → stale code/toolchain"
            note "recreate it: ${HERE}/dd-recreate ${c#dd-}   (state is preserved)"
        fi
    else
        note "${IMAGE} not present locally — skipping image-freshness check"
    fi
}

main() {
    local list; list="$(containers "${1:-}")"
    if [[ -z "${list}" ]]; then
        echo "no dd-* worker containers found"; exit 0
    fi
    for c in ${list}; do check_one "$c"; done
    printf '\n\033[1mdd-doctor: %d passed, %d failed\033[0m\n' "$pass" "$fail"
    [[ "$fail" -eq 0 ]]
}

main "${1:-}"
