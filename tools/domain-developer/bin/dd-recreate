#!/usr/bin/env bash
# dd-recreate <site>
#
# Recreate a worker container WITHOUT losing state. Safe by construction now
# that all per-site state lives on host bind mounts (REDESIGN.md): we stop + rm
# the container and start a fresh one from the current image. State (Claude
# config, credentials, transcripts, scratch) lives under
# tools/domain-developer/state/<site>/ and on the host's ~/.claude/projects, so
# it survives untouched.
#
# Re-uses the panel (the port owner) if it's up; otherwise falls back to the
# CLI entry point (no published ports).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANEL_URL="${DD_PANEL_URL:-http://127.0.0.1:7777}"

site="${1:-}"
[[ -n "${site}" ]] || { echo "usage: dd-recreate <site>" >&2; exit 1; }
[[ "${site}" =~ ^[A-Za-z0-9._-]+$ && "${site}" != .* && "${site}" != *..* ]] || { echo "invalid site name: ${site}" >&2; exit 1; }
cname="dd-${site}"

# Improvement workers are keyed by an imp-* session id rather than a site
# directory. Capture their real site/worktree before removing the old
# container so the alert's suggested command works for both worker kinds.
worker_site=""
worker_workspace=""
if docker inspect "${cname}" >/dev/null 2>&1; then
    worker_env="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "${cname}" 2>/dev/null || true)"
    worker_site="$(sed -n 's/^SITE_NAME=//p' <<<"${worker_env}")"
    worker_workspace="$(sed -n 's/^SITE_DIR=//p' <<<"${worker_env}")"
fi

LIFECYCLE_LOCK="${DD_LIFECYCLE_LOCK:-${HERE}/../state/.lifecycle.lock}"
mkdir -p "$(dirname "${LIFECYCLE_LOCK}")"
exec 8>"${LIFECYCLE_LOCK}"
flock -w "${DD_LIFECYCLE_LOCK_WAIT:-30}" -x 8 || { echo "could not acquire worker lifecycle lock" >&2; exit 75; }

echo "[dd-recreate] stopping + removing ${cname} (host-bind state is preserved)..."
docker stop "${cname}" >/dev/null 2>&1 || true
if docker inspect "${cname}" >/dev/null 2>&1 && ! docker rm "${cname}" >/dev/null 2>&1; then
    echo "[dd-recreate] could not remove ${cname}; refusing to start a replacement" >&2
    exit 1
fi
flock -u 8 2>/dev/null || true
exec 8>&-

if [[ "${site}" == imp-* && -n "${worker_site}" && -d "${worker_workspace}" ]]; then
    echo "[dd-recreate] improvement worker — rebuilding ${worker_site} worktree..."
    node -e 'require("./tools/fleet-dashboard/server/devsandbox").start(process.cwd(), process.argv[1], {instance: process.argv[2], workspaceDir: process.argv[3]}).then(() => process.exit(0)).catch(error => { console.error(error.message || error); process.exit(1); })' \
        "${worker_site}" "${site}" "${worker_workspace}"
elif curl -fsS --max-time 10 "${PANEL_URL}/api/health" >/dev/null 2>&1; then
    echo "[dd-recreate] panel up — starting via panel (preserves port assignments)..."
    curl -fsS --max-time 30 -X POST "${PANEL_URL}/api/sites/${site}/start" && echo
else
    echo "[dd-recreate] panel down — starting via CLI (no published ports)..."
    "${HERE}/domain-developer" "${site}" true
fi

echo "[dd-recreate] done. Verify with: ${HERE}/dd-doctor ${site}"
echo "[dd-recreate] if Claude reports not logged in, open the worker and run: claude /login"
