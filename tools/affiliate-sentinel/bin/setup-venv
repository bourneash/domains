#!/usr/bin/env bash
# (Re)build the sentinel's pinned virtualenv. Idempotent; safe to re-run.
set -euo pipefail
TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${PYTHON:-python3}"
"$PY" -m venv "$TOOL_DIR/.venv"
"$TOOL_DIR/.venv/bin/pip" install -q --disable-pip-version-check -r "$TOOL_DIR/requirements.txt"
"$TOOL_DIR/.venv/bin/python" - <<'PYCHK'
import httpx
import yaml
from importlib.metadata import version
import cloakbrowser
import playwright.sync_api

print(
    "affiliate-sentinel venv ready — "
    f"httpx {httpx.__version__}, pyyaml {yaml.__version__}, "
    f"cloakbrowser {version('cloakbrowser')}, playwright {version('playwright')}"
)
PYCHK
