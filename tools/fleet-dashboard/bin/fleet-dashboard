#!/usr/bin/env bash
# Operator entry point for the Fleet Dashboard.
#
# FD_TOKEN no longer lives in the shared fleet .env (B2). Vaultwarden is its
# home and tools/env-broker renders it into a 0400 file holding three keys, which
# compose loads via env_file:. This command owns that wiring. FD_TOKEN stays
# stable across ordinary starts/restarts; rotate-token is the only command that
# changes it, and it rotates in the VAULT then re-renders — writing the rendered
# file directly would be silently reverted by the next `env_broker.py render`.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_DIR="$(cd "${HERE}/.." && pwd)"
DOMAINS_ROOT="${FD_DOMAINS_ROOT:-$(cd "${TOOL_DIR}/../.." && pwd)}"
BROKER="${FD_ENV_BROKER:-${DOMAINS_ROOT}/tools/env-broker/env_broker.py}"
ENV_FILE="${FD_ENV_FILE:-${DOMAINS_ROOT}/tools/env-broker/rendered/tool-fleet-dashboard.env}"
URL="${FD_DASHBOARD_URL:-http://127.0.0.1:4754}"

usage() {
  cat <<'EOF'
Usage: tools/fleet-dashboard/bin/fleet-dashboard <command>

Commands:
  up            Start or update the dashboard with its env-broker render
  restart       Restart the dashboard (starts it if it is absent)
  status        Show container and unauthenticated health/auth status
  token         Print the current FD_TOKEN for browser login
  rotate-token  Generate a new FD_TOKEN in Vaultwarden, re-render, recreate
  help          Show this help

Routine token renewal is unnecessary. Rotate only after suspected disclosure.
EOF
}

die() {
  printf 'fleet-dashboard: %s\n' "$*" >&2
  exit 1
}

require_env_file() {
  [[ -f "${ENV_FILE}" ]] || die "scoped env not found: ${ENV_FILE}
Render it first:  ${BROKER} render --all"
}

read_token() {
  awk '
    /^FD_TOKEN=/ {
      sub(/^FD_TOKEN=/, "");
      token = $0;
    }
    END { print token }
  ' "${ENV_FILE}"
}

configure_compose_env() {
  local docker_socket socket_gid group_gid
  [[ -n "${DOCKER_GID:-}" ]] && return 0

  docker_socket="${FD_DOCKER_SOCKET:-/var/run/docker.sock}"
  socket_gid="$(stat -c %g "${docker_socket}" 2>/dev/null || true)"
  group_gid="$(getent group docker 2>/dev/null | awk -F: 'NR == 1 { print $3 }' || true)"

  # The socket is the authority. A stale/mismatched `docker` group database
  # entry leaves the uid-1000 panel apparently healthy but unable to perform
  # its core Docker reads (including the Errors scanner). Fall back to the
  # named group only for test/remote contexts where the socket is absent.
  if [[ "${socket_gid}" =~ ^[0-9]+$ ]]; then
    export DOCKER_GID="${socket_gid}"
  elif [[ "${group_gid}" =~ ^[0-9]+$ ]]; then
    export DOCKER_GID="${group_gid}"
  else
    die "cannot determine Docker socket GID from ${docker_socket} or the docker group"
  fi
}

compose() {
  configure_compose_env
  (
    cd "${TOOL_DIR}"
    docker compose --env-file "${ENV_FILE}" "$@"
  )
}

wait_until_ready() {
  local attempts="${FD_HEALTHCHECK_ATTEMPTS:-30}"
  local delay="${FD_HEALTHCHECK_DELAY:-0.5}"
  local i

  for ((i = 1; i <= attempts; i++)); do
    if curl -fsS --max-time 2 "${URL}/healthz" >/dev/null 2>&1; then
      printf '✓ Fleet Dashboard ready: %s/\n' "${URL}"
      return 0
    fi
    sleep "${delay}"
  done

  printf 'fleet-dashboard: panel did not become ready at %s/\n' "${URL}" >&2
  docker logs --tail 30 fleet-dashboard >&2 2>/dev/null || true
  return 1
}

replace_token() {
  # Vaultwarden is FD_TOKEN's only home, so rotation is a vault write followed
  # by a re-render — the broker owns both. Writing the rendered file directly
  # would look like it worked and be reverted by the next `render --all`,
  # leaving every browser session dead with no obvious cause.
  local new_token="$1"
  printf '%s' "${new_token}" | "${BROKER}" set-secret --group dashboard --key FD_TOKEN >/dev/null || return 1
  [[ "$(read_token)" == "${new_token}" ]] || return 1
}

print_token_hint() {
  printf 'Retrieve it locally when needed with:\n  %s token\n' "$0"
}

command="${1:-help}"
case "${command}" in
  up|start)
    require_env_file
    [[ -n "$(read_token)" ]] || die "FD_TOKEN is missing from ${ENV_FILE}"
    compose up -d panel
    wait_until_ready
    ;;

  restart)
    require_env_file
    [[ -n "$(read_token)" ]] || die "FD_TOKEN is missing from ${ENV_FILE}"
    if docker inspect fleet-dashboard >/dev/null 2>&1; then
      compose restart panel
    else
      compose up -d panel
    fi
    wait_until_ready
    ;;

  status)
    require_env_file
    compose ps panel
    if auth_status="$(curl -fsS --max-time 2 "${URL}/api/auth" 2>/dev/null)"; then
      printf 'health: ready\nauth:   %s\n' "${auth_status}"
    else
      printf 'health: unavailable (%s/)\n' "${URL}"
      exit 1
    fi
    ;;

  token|show-token)
    require_env_file
    token="$(read_token)"
    [[ -n "${token}" ]] || die "FD_TOKEN is missing from ${ENV_FILE}"
    printf '%s\n' "${token}"
    ;;

  rotate-token)
    require_env_file
    new_token="$(openssl rand -hex 32)"
    [[ "${new_token}" =~ ^[0-9a-f]{64}$ ]] || die "openssl returned an invalid token"
    replace_token "${new_token}" || die "rotation failed; FD_TOKEN is unchanged"
    printf 'FD_TOKEN rotated in Vaultwarden and re-rendered to %s.\n' "${ENV_FILE}"
    printf 'Existing browser sessions are invalid.\n'
    if ! compose up -d --force-recreate panel; then
      printf 'fleet-dashboard: panel recreation failed; the new token remains persisted.\n' >&2
      print_token_hint >&2
      exit 1
    fi
    if ! wait_until_ready; then
      printf 'fleet-dashboard: the new token remains persisted.\n' >&2
      print_token_hint >&2
      exit 1
    fi
    printf 'Fleet Dashboard is running with the new token.\n'
    print_token_hint
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    usage >&2
    die "unknown command: ${command}"
    ;;
esac
