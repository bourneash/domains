#!/usr/bin/env bash
# Guide Idea Seeder — self-contained (mirrors run-engineer.sh's shape): does
# its own cheap bash gate and invokes Claude ONLY when the idea backlog is
# genuinely low. Called from run-role.sh's guide-idea-seeder branch, which
# already handles the lock/log/status-file plumbing — this script just does
# the actual work and exits nonzero on a real failure.
#
# Silent on a healthy queue (no Slack, no Claude turn) — this role should
# almost never have anything to say. It's the fallback for when Jesse hasn't
# fed the queue by hand via the dashboard, not a daily announcement.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"

GQ_CLI="$REPO_ROOT/.monorepo-tools/guide-queue/lib/cli.py"
[[ -f "$GQ_CLI" ]] || GQ_CLI="$REPO_ROOT/../../tools/guide-queue/lib/cli.py"
if [[ ! -f "$GQ_CLI" ]]; then
  echo "guide-queue CLI not found (checked .monorepo-tools and ../../tools) — cannot run" >&2
  exit 1
fi

if [ -f ".env.shared" ]; then set -a; . ".env.shared"; set +a; fi

CLAUDE_TRACKED="$REPO_ROOT/.monorepo-tools/scripts/claude-tracked.sh"
[[ -x "$CLAUDE_TRACKED" ]] || CLAUDE_TRACKED="$REPO_ROOT/../../tools/scripts/claude-tracked.sh"
NOTIFY="$REPO_ROOT/ops/scripts/notify-slack.sh"
CHANNEL="${{{SLACK_CHANNEL_VAR}}:-{{SLACK_CHANNEL_DEFAULT}}}"

# Read the configured minimum from ops/tracked.yaml (manual.guide_ideas_min),
# default 3 if unset/unparseable. Same config surface the dashboard's cadence
# editor writes to.
MIN_IDEAS=$(python3 -c "
import yaml
try:
    d = yaml.safe_load(open('ops/tracked.yaml')) or {}
    v = (d.get('manual') or {}).get('guide_ideas_min')
    print(int(v) if v else 3)
except Exception:
    print(3)
" 2>/dev/null || echo 3)

COUNT=$(python3 "$GQ_CLI" list "$REPO_ROOT" ideas | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")

echo "[guide-idea-seeder] ideas queue: $COUNT/$MIN_IDEAS"

if [[ "$COUNT" -ge "$MIN_IDEAS" ]]; then
  echo "[guide-idea-seeder] queue healthy — skipping Claude entirely"
  exit 0
fi

NEEDED=$(( MIN_IDEAS - COUNT ))
EXISTING_TITLES=$(python3 "$GQ_CLI" existing-titles "$REPO_ROOT")

PROMPT="$(cat ops/roles/guide-idea-seeder.md)

Idea backlog is low: $COUNT/$MIN_IDEAS. Add $NEEDED new idea(s) now.

Titles already anywhere in the pipeline (any status) — do not duplicate:
$EXISTING_TITLES

Today is $(date -Iseconds). The current working directory is $(pwd). Begin."

set +e
CRON_ROLE=guide-idea-seeder "$CLAUDE_TRACKED" "$PROMPT" \
  --max-turns 15 \
  --dangerously-skip-permissions \
  --model claude-sonnet-4-6
STATUS=$?
set -e

if [[ $STATUS -ne 0 ]]; then
  [[ -x "$NOTIFY" ]] && "$NOTIFY" "$CHANNEL" ":x: *{{SITE_NAME}}* guide-idea-seeder failed (exit=$STATUS)" "danger" 2>/dev/null || true
  exit $STATUS
fi

NEW_COUNT=$(python3 "$GQ_CLI" list "$REPO_ROOT" ideas | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")
echo "[guide-idea-seeder] done — ideas queue now $NEW_COUNT"
[[ -x "$NOTIFY" ]] && "$NOTIFY" "$CHANNEL" ":bulb: *{{SITE_NAME}}* guide-idea-seeder — added $((NEW_COUNT - COUNT)) idea(s), queue now $NEW_COUNT/$MIN_IDEAS" "good" 2>/dev/null || true
exit 0
