#!/usr/bin/env bash
# Runs INSIDE the worker container (spun by run-guide-publisher.sh via
# `docker compose run --rm --entrypoint bash worker ops/scripts/guide-publish.sh
# <status> <file>`) — needs node/npm for the build gate and git/ssh for push,
# which the cron container doesn't have. Mirrors deploy.sh's split for the
# same reason.
#
# Promotes one guide-queue item to the live site: copies its generated
# images into site/public/, strips queue-only frontmatter, writes the final
# guide file into site/src/content/guides/, runs the build gate, commits,
# pushes, queues a deploy (touches .deploy-needed — the existing deployer
# role takes it from there, unchanged), and moves the queue item to released/.

set -euo pipefail

SOURCE_STATUS="${1:?usage: guide-publish.sh <status> <file>}"
FILE="${2:?usage: guide-publish.sh <status> <file>}"

REPO_ROOT="/work"
cd "$REPO_ROOT"

GUIDE_QUEUE_LIB_DIR="$REPO_ROOT/.monorepo-tools/guide-queue/lib"
GQ_CLI="$GUIDE_QUEUE_LIB_DIR/cli.py"
if [[ ! -f "$GQ_CLI" ]]; then
  echo "guide-queue CLI not found at $GQ_CLI" >&2
  exit 1
fi

if [ -f ".env.shared" ]; then set -a; . ".env.shared"; set +a; fi
NOTIFY="$REPO_ROOT/ops/scripts/notify-slack.sh"
CHANNEL="${{{SLACK_CHANNEL_VAR}}:-{{SLACK_CHANNEL_DEFAULT}}}"
fail() {
  echo "[guide-publish] FAILED: $1" >&2
  [[ -x "$NOTIFY" ]] && "$NOTIFY" "$CHANNEL" ":x: *{{SITE_NAME}}* guide-publish failed: $1" "danger" 2>/dev/null || true
  exit 1
}

git config user.name "${GIT_USER_NAME:-{{GIT_USER_NAME}}}"
git config user.email "${GIT_USER_EMAIL:-bot@{{SITE_NAME}}}"

# --- Write the final guide file + copy images, all in one python step ---
RESULT_JSON=$(GUIDE_QUEUE_LIB_DIR="$GUIDE_QUEUE_LIB_DIR" python3 - "$REPO_ROOT" "$SOURCE_STATUS" "$FILE" <<'PY'
import json, os, sys, shutil
from pathlib import Path

sys.path.insert(0, os.environ["GUIDE_QUEUE_LIB_DIR"])
import guide_queue as gq

repo_root, status, filename = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
item = gq.get_item(repo_root, status, filename)
meta, body = dict(item["meta"]), item["body"]
qid = meta.get("queue_id") or gq.slugify(meta.get("title", filename))

# Match this site's OWN existing hero/card convention exactly (NOT a new
# frontmatter field — nothing in the Astro templates would read one; see
# generate-guide-images.py's docstring for the full reasoning):
#   hero -> site/public/guides/heroes/<id>.jpg   (optional, glob-detected by
#           site/src/pages/guides/[...slug].astro)
#   card -> site/public/images/guides/cards/<id>.webp, referenced by adding
#           this guide's id to site/src/lib/guideIcons.ts's guideIconMap
guides_dir = repo_root / "site" / "src" / "content" / "guides"
guide_path = guides_dir / f"{qid}.md"
if len(body.strip()) < 400:
    # A writer run that died mid-way leaves a body-less item stranded in
    # drafted/ — and nothing ever retries a drafted item, the writer only reads
    # ideas/. Without this the next cadence tick ships an empty guide (seen on
    # shoptopless.com 2026-08-25). Same quarantine path as a duplicate.
    print(json.dumps({"ok": False, "duplicate": True, "qid": qid,
                      "title": meta.get("title", qid),
                      "error": f"body is only {len(body.strip())} chars — draft was never written"}))
    sys.exit(0)

if guide_path.exists():
    # Checked FIRST, before anything is written. The image copies below used to
    # run ahead of this and silently overwrote the LIVE hero/card of the
    # already-published guide on every one of these failed runs.
    print(json.dumps({"ok": False, "duplicate": True, "qid": qid,
                      "title": meta.get("title", qid),
                      "error": f"{guide_path} already exists — refusing to overwrite"}))
    sys.exit(0)

heroes_dir = repo_root / "site" / "public" / "guides" / "heroes"
cards_dir = repo_root / "site" / "public" / "images" / "guides" / "cards"
heroes_dir.mkdir(parents=True, exist_ok=True)
cards_dir.mkdir(parents=True, exist_ok=True)

hero_src = meta.get("hero_image")
card_src = meta.get("card_image")
got_card = False
if hero_src and (repo_root / hero_src).is_file():
    shutil.copyfile(repo_root / hero_src, heroes_dir / f"{qid}.jpg")
if card_src and (repo_root / card_src).is_file():
    shutil.copyfile(repo_root / card_src, cards_dir / f"{qid}.webp")
    got_card = True

if got_card:
    icons_ts = repo_root / "site" / "src" / "lib" / "guideIcons.ts"
    text = icons_ts.read_text(encoding="utf-8")
    entry = f"  '{qid}': '{qid}',"
    if f"'{qid}':" not in text:
        # Insert right before the map's closing `};` — same one-entry-per-line
        # shape as every existing row.
        text = text.replace("};\n", f"{entry}\n}};\n", 1) if text.rstrip().endswith("};") else text + f"\n{entry}\n"
        icons_ts.write_text(text, encoding="utf-8")

final_meta = gq.strip_queue_fields(meta)

guides_dir.mkdir(parents=True, exist_ok=True)
guide_path = guides_dir / f"{qid}.md"
guide_path.write_text(gq.serialize_item(final_meta, body), encoding="utf-8")

# Deliberately NOT moving the queue item to released/ here — that has to
# wait until the build gate below actually passes (found as a real bug via
# a live reviewtattoo.com e2e test, 2026-08-10: moving first meant a build
# failure left the item mis-filed as "released" while nothing was actually
# published, and the fail() message's "item stays in $SOURCE_STATUS/" was
# false). See the move_item() call after the build gate instead.

print(json.dumps({
    "ok": True, "qid": qid, "guide_path": str(guide_path.relative_to(repo_root)),
    "title": meta.get("title", qid),
}))
PY
)

echo "[guide-publish] $RESULT_JSON"
OK=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin)['ok'])")
DUP=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin).get('duplicate',False))")

if [[ "$OK" != "True" && "$DUP" == "True" ]]; then
  # Quarantine to rejected/ and exit 75 — the caller reads 75 as "queue head
  # cleared, pick the next candidate now", NOT as a publish success (so the
  # cadence clock is deliberately left unstamped).
  DUP_TITLE=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin).get('title',''))")
  DUP_WHY=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin).get('error',''))")
  echo "[guide-publish] unpublishable draft — quarantining to rejected/: $DUP_WHY"
  GUIDE_QUEUE_LIB_DIR="$GUIDE_QUEUE_LIB_DIR" REPO_ROOT="$REPO_ROOT" SOURCE_STATUS="$SOURCE_STATUS" FILE="$FILE" python3 - <<'PYDUP'
import os, sys
sys.path.insert(0, os.environ["GUIDE_QUEUE_LIB_DIR"])
import guide_queue as gq
gq.move_item(os.environ["REPO_ROOT"], os.environ["SOURCE_STATUS"], os.environ["FILE"], "rejected")
PYDUP
  git add -A "ops/guide-queue/" 2>/dev/null || true
  git diff --cached --quiet || {
    git commit -m "guide-queue: quarantine draft \"$DUP_TITLE\" — $DUP_WHY" -q
    git push origin main -q 2>&1 | tail -3 || true
  }
  [[ -x "$NOTIFY" ]] && "$NOTIFY" "$CHANNEL" ":warning: *{{SITE_NAME}}* guide-publisher skipped \"$DUP_TITLE\" — $DUP_WHY; draft moved to rejected/" "warning" 2>/dev/null || true
  exit 75
fi
if [[ "$OK" != "True" ]]; then
  ERR=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin).get('error','unknown'))")
  fail "$ERR"
fi

GUIDE_PATH=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin)['guide_path'])")
QID=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin)['qid'])")
TITLE=$(echo "$RESULT_JSON" | python3 -c "import json,sys;print(json.load(sys.stdin)['title'])")

# --- Build gate (mandatory, same as content-writer's) ---
echo "[guide-publish] running build gate..."
if ! (cd site && npm run build) ; then
  fail "build failed for $GUIDE_PATH — item stays in $SOURCE_STATUS/ for retry"
fi

# --- Only now move the queue item — build is proven good ---
GUIDE_QUEUE_LIB_DIR="$GUIDE_QUEUE_LIB_DIR" REPO_ROOT="$REPO_ROOT" SOURCE_STATUS="$SOURCE_STATUS" FILE="$FILE" python3 - <<'PYMOVE'
import os, sys
sys.path.insert(0, os.environ["GUIDE_QUEUE_LIB_DIR"])
import guide_queue as gq
gq.move_item(os.environ["REPO_ROOT"], os.environ["SOURCE_STATUS"], os.environ["FILE"], "released")
PYMOVE

# --- Commit + push ---
# Stamp the cadence clock HERE, in the same commit as the release, because this
# is the container that can actually push. Writing it afterwards in the CRON
# container left origin/main carrying a release with no matching cadence bump,
# so anything reading from a fresh clone saw "never released" and republished.
date +%s > "$REPO_ROOT/ops/guide-queue/.last-released"

git add "$GUIDE_PATH" "site/public/guides/heroes/" "site/public/images/guides/cards/" \
  "site/src/lib/guideIcons.ts" "ops/guide-queue/" "ops/guide-queue/.last-released" 2>/dev/null || true
if git diff --cached --quiet; then
  fail "nothing staged after a successful write — unexpected"
fi
git commit -m "content: publish guide \"$TITLE\" from guide-queue" -q
if ! git push origin main 2>&1 | tail -5; then
  fail "git push failed after commit — resolve manually, commit is local-only"
fi

touch "$REPO_ROOT/.deploy-needed"
echo "[guide-publish] queued deploy via .deploy-needed"

[[ -x "$NOTIFY" ]] && "$NOTIFY" "$CHANNEL" ":rocket: *{{SITE_NAME}}* guide-publisher released \"$TITLE\" ($GUIDE_PATH) — deploy queued" "good" 2>/dev/null || true
echo "[guide-publish] done"
exit 0
