#!/usr/bin/env bash
# fleet-image-build [all|cron|worker] [--version X] [--no-cache] [--roll] [--sites a,b] [--allow-partial]
#
# Build, tag and (optionally) roll the fleet's SHARED site images.
# Normal releases are coordinated: both images are built and smoke-tested
# before either :latest tag is promoted. Use --allow-partial only for an
# explicitly isolated emergency/debug operation.
#
# There are exactly two of them:
#   fleet-site-cron:latest    the legacy/rollback supercronic scheduler
#   fleet-site-worker:latest  the one-shot role runner, `run --rm` per invocation
#
# They replace 53 per-site Dockerfiles. The whole point is that a change lands
# in ONE place and rolls deliberately, so this script is the only sanctioned way
# to move those tags.
#
# TAGGING MODEL — read before changing it.
# Every site's compose references the plain `:latest` tag, NOT a pinned version.
# That looks wrong for reproducibility and is deliberate: pinning versions in 27
# compose files means a roll is 27 edits, which is how the fleet ended up with
# 53 divergent files in the first place. Instead:
#   - the build stamps an immutable org.domains.fleet.version LABEL,
#   - a version-tagged image (fleet-site-cron:<version>) is kept as a rollback,
#   - fleet-doctor asserts every RUNNING container's image ID equals the current
#     :latest image ID, so drift is loud rather than silent.
# That gives one-place rolls with drift detection, which is the cattle property
# we actually want — not the illusion of pinning.
#
# A running legacy container does NOT pick up a new image. That is not a bug:
# a scheduler mid-job should not vanish under it. `--roll` recreates released
# sites; adopted sites are owned by fleet-scheduler and are skipped.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="$(cd "${HERE}/.." && pwd)"
DOMAINS_ROOT="${FLEET_DOMAINS_ROOT:-$(cd "${IMAGES_DIR}/../.." && pwd)}"
VERSION_FILE="${IMAGES_DIR}/VERSION"

TARGET="${1:-all}"
[[ "$TARGET" == -* ]] && TARGET="all" || shift || true

VERSION=""
NO_CACHE=0
ROLL=0
ONLY_SITES=""
# Escape hatch. Exists for debugging a build whose smoke failure is the thing
# you are investigating — not for shipping past a red gate.
SKIP_SMOKE=0
ALLOW_PARTIAL=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)  shift; VERSION="${1:-}" ;;
    --no-cache) NO_CACHE=1 ;;
    --roll)     ROLL=1 ;;
    --sites)    shift; ONLY_SITES="${1:-}" ;;
    --skip-smoke) SKIP_SMOKE=1 ;;
    --allow-partial) ALLOW_PARTIAL=1 ;;
    -h|--help)  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done

case "$TARGET" in
  cron|worker|all) ;;
  *) echo "usage: fleet-image-build [all|cron|worker] [--version X] [--no-cache] [--roll] [--sites a,b] [--allow-partial]" >&2; exit 1 ;;
esac

if [[ "$TARGET" != all && "$ALLOW_PARTIAL" -eq 0 ]]; then
  printf '\033[31m[fleet-image-build]\033[0m refusing partial shared-image release (%s); build both images together, or pass --allow-partial for an emergency/debug operation\n' "$TARGET" >&2
  exit 1
fi

if (( SKIP_SMOKE && !ALLOW_PARTIAL )); then
  printf '\033[31m[fleet-image-build]\033[0m --skip-smoke requires --allow-partial; unverified images may not enter a coordinated release\n' >&2
  exit 1
fi

if [[ -z "$VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "$VERSION_FILE" 2>/dev/null || true)"
  [[ -n "$VERSION" ]] || VERSION="0.0.0"
fi

say()  { printf '\033[1m[fleet-image-build]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[fleet-image-build]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31m[fleet-image-build]\033[0m %s\n' "$*" >&2; exit 1; }

# Shared tags are fleet-wide mutable state. Serialize builders so two cron
# jobs (or a self-heal plus a human release) cannot interleave promotions.
BUILD_LOCK="${FLEET_IMAGE_BUILD_LOCK:-/tmp/fleet-image-build.lock}"
exec 8>"$BUILD_LOCK"
BUILD_LOCK_TIMEOUT="${FLEET_IMAGE_BUILD_LOCK_TIMEOUT:-900}"
flock -w "$BUILD_LOCK_TIMEOUT" 8 || die "another fleet image build is still running after ${BUILD_LOCK_TIMEOUT}s (lock: ${BUILD_LOCK})"

# Build -> SMOKE -> verify both -> promote. In a normal release neither
# :latest tag moves if either image fails.
#
# This ordering is the whole point. Tagging :latest at build time (the original
# behaviour) meant a broken image became the fleet's current image the instant
# it compiled, and `--roll` would then push it to 26 sites. Three regressions
# shipped that way on 2026-08-23 — a missing venv path, no Playwright browser
# story, and a presence-guard that never matched — every one of which the smoke
# suite now catches in about fifteen seconds.
#
# On failure the previous :latest tags are left exactly where they were, so the
# fleet keeps running the last pair known to work.
build_one() {
  local kind="$1"
  local ctx="${IMAGES_DIR}/${kind}"
  local image="fleet-site-${kind}"
  [[ -f "${ctx}/Dockerfile" ]] || die "no Dockerfile at ${ctx}"

  # Build the VERSION tag only. :latest is untouched until smoke passes.
  local args=(build --build-arg "FLEET_IMAGE_VERSION=${VERSION}"
              -t "${image}:${VERSION}"
              -f "${ctx}/Dockerfile" "${ctx}")
  (( NO_CACHE )) && args=(build --no-cache "${args[@]:1}")

  say "building ${image}:${VERSION}"
  docker "${args[@]}" || die "${image} build FAILED — existing :latest left untouched"

  local ver
  ver="$(docker image inspect --format '{{index .Config.Labels "org.domains.fleet.version"}}' "${image}:${VERSION}")"
  [[ "$ver" == "$VERSION" ]] || die "${image}:${VERSION} label is '${ver}' — build did not stamp correctly"

  if (( SKIP_SMOKE )); then
    warn "--skip-smoke: staging ${image}:${VERSION} WITHOUT smoke verification"
  else
    say "smoke-testing ${image}:${VERSION} before promoting it to :latest"
    if ! "${HERE}/fleet-image-smoke" "${kind}" --tag "${VERSION}"; then
      die "${image}:${VERSION} FAILED smoke — :latest NOT moved, the fleet keeps running the previous image pair. Fix and rebuild, or inspect with: docker run --rm -it --entrypoint bash ${image}:${VERSION}"
    fi
  fi

  say "✓ staged ${image}:${VERSION} (version ${ver})"
}

promote_pair() {
  local old_cron old_worker cron_id worker_id
  old_cron="$(docker image inspect --format '{{.Id}}' fleet-site-cron:latest 2>/dev/null || true)"
  old_worker="$(docker image inspect --format '{{.Id}}' fleet-site-worker:latest 2>/dev/null || true)"

  docker tag "fleet-site-cron:${VERSION}" fleet-site-cron:latest ||
    die "could not promote fleet-site-cron:${VERSION}; no :latest tags were changed"
  if ! docker tag "fleet-site-worker:${VERSION}" fleet-site-worker:latest; then
    [[ -n "$old_cron" ]] && docker tag "$old_cron" fleet-site-cron:latest >/dev/null 2>&1 || true
    die "could not promote fleet-site-worker:${VERSION}; restored the previous cron tag"
  fi

  cron_id="$(docker image inspect --format '{{.Id}}' fleet-site-cron:latest 2>/dev/null || true)"
  worker_id="$(docker image inspect --format '{{.Id}}' fleet-site-worker:latest 2>/dev/null || true)"
  if [[ -z "$cron_id" || -z "$worker_id" ]] ||
     [[ "$(docker image inspect --format '{{index .Config.Labels \"org.domains.fleet.version\"}}' fleet-site-cron:latest 2>/dev/null || true)" != "$VERSION" ]] ||
     [[ "$(docker image inspect --format '{{index .Config.Labels \"org.domains.fleet.version\"}}' fleet-site-worker:latest 2>/dev/null || true)" != "$VERSION" ]]; then
    [[ -n "$old_cron" ]] && docker tag "$old_cron" fleet-site-cron:latest >/dev/null 2>&1 || true
    [[ -n "$old_worker" ]] && docker tag "$old_worker" fleet-site-worker:latest >/dev/null 2>&1 || true
    die "promoted image labels failed final pair verification; restored previous tags where possible"
  fi
  say "✓ promoted fleet-site-cron:latest = ${cron_id:7:12} (version ${VERSION})"
  say "✓ promoted fleet-site-worker:latest = ${worker_id:7:12} (version ${VERSION})"
}

verify_staged_pair() {
  local cron_v worker_v
  cron_v="$(docker image inspect --format '{{index .Config.Labels "org.domains.fleet.version"}}' "fleet-site-cron:${VERSION}" 2>/dev/null || true)"
  worker_v="$(docker image inspect --format '{{index .Config.Labels "org.domains.fleet.version"}}' "fleet-site-worker:${VERSION}" 2>/dev/null || true)"
  [[ "$cron_v" == "$VERSION" && "$worker_v" == "$VERSION" ]] ||
    die "staged image labels do not agree with VERSION=${VERSION} (cron=${cron_v:-missing} worker=${worker_v:-missing}); no :latest tags were promoted"
}

# ── which sites are on the shared images ────────────────────────────────────
# Source of truth is the compose file itself: a site is migrated when its cron
# service references the shared image. No separate list to drift out of sync.
migrated_sites() {
  local d name
  for d in "${DOMAINS_ROOT}"/sites/*/; do
    name="$(basename "$d")"
    [[ -f "${d}docker-compose.yml" ]] || continue
    grep -qE 'image:\s*fleet-site-(cron|worker):' "${d}docker-compose.yml" 2>/dev/null || continue
    if [[ -n "$ONLY_SITES" ]]; then
      [[ ",$ONLY_SITES," == *",$name,"* ]] || continue
    fi
    printf '%s\n' "$name"
  done
}

is_adopted() {
  [[ -e "${DOMAINS_ROOT}/tools/fleet-scheduler/data/adopted/$1" ]]
}

roll_sites() {
  local rolled=0 failed=0
  local want_cron
  want_cron="$(docker image inspect --format '{{.Id}}' fleet-site-cron:latest 2>/dev/null || true)"

  while read -r site; do
    [[ -n "$site" ]] || continue
    if is_adopted "$site"; then
      say "  ${site}: adopted by fleet-scheduler — skipping legacy cron roll"
      continue
    fi
    local dir="${DOMAINS_ROOT}/sites/${site}"
    local cname="${site%%.*}-cron"
    local have
    have="$(docker inspect --format '{{.Image}}' "$cname" 2>/dev/null || true)"

    if [[ -n "$have" && "$have" == "$want_cron" ]]; then
      say "  ${site}: already on the current image — skipping"
      continue
    fi

    say "  ${site}: recreating ${cname} on the current image"
    # `up -d --force-recreate` (not restart): restart reuses the container's
    # creation-time image, which is exactly the stale-image drift this whole
    # migration exists to eliminate.
    if ( cd "$dir" && docker compose up -d --force-recreate cron >/dev/null 2>&1 ); then
      rolled=$((rolled+1))
    else
      warn "  ${site}: recreate FAILED — see: (cd ${dir} && docker compose up -d --force-recreate cron)"
      failed=$((failed+1))
    fi
  done < <(migrated_sites)

  say "rolled ${rolled} site(s), ${failed} failure(s)"
  (( failed == 0 ))
}

if [[ "$TARGET" == all ]]; then
  # Stage both first. A failed build or smoke test leaves the promoted pair
  # untouched.
  build_one cron
  build_one worker
  verify_staged_pair
  promote_pair
else
  build_one "$TARGET"
  # Explicit partial mode is retained only for emergency/debug operations.
  local_image="fleet-site-${TARGET}"
  docker tag "${local_image}:${VERSION}" "${local_image}:latest" ||
    die "could not promote ${local_image}:${VERSION} to :latest"
  say "✓ promoted ${local_image}:latest (partial release; version ${VERSION})"
fi

if (( ROLL )); then
  say "rolling released-site legacy cron containers onto the current image..."
  n="$(migrated_sites | wc -l)"
  if [[ "$n" -eq 0 ]]; then
    warn "no sites reference the shared images yet — nothing to roll"
  else
    roll_sites || die "some sites failed to roll (see above); fix them before treating this roll as done"
  fi
fi

say "done. Verify with: ${IMAGES_DIR}/bin/fleet-doctor"
