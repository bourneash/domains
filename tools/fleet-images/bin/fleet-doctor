#!/usr/bin/env bash
# fleet-doctor [site] [--quiet] [--json]
#
# The executable spec for the fleet's container/image invariants — the
# whole-fleet analogue of tools/domain-developer/bin/dd-doctor.
#
# It exists because consolidation without a gate decays. The fleet reached 53
# hand-maintained image definitions in 23 substantive variants precisely
# because nothing ever asserted "these should be the same". Shipping one shared
# image without shipping this would just restart that clock.
#
# CHECKS, per cron-capable site:
#   1. compose references the shared cron image (not a per-site build:)
#   2. no per-site ops/docker/Dockerfile.cron survives
#   3. crontab is BIND-MOUNTED, not baked   <- the drift that bit weapontester
#   4. the cron container is running
#   5. it runs the CURRENT fleet-site-cron:latest image ID
#   6. it runs as uid 1000, never root
#   7. compose references the shared worker image (not a per-site build:)
#   8. no per-site ops/docker/Dockerfile.worker survives
#
# Checks 7 and 8 report as PENDING (not failed) for a site that has not been
# migrated to the shared worker yet, so this can gate the cron rollout before
# the worker rollout exists. A site with no worker service at all is exempt.
#
# Exit 0 only when every checked site passes every applicable check.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="$(cd "${HERE}/.." && pwd)"
DOMAINS_ROOT="${FLEET_DOMAINS_ROOT:-$(cd "${IMAGES_DIR}/../.." && pwd)}"
SITES_DIR="${DOMAINS_ROOT}/sites"

CRON_IMAGE="${FLEET_CRON_IMAGE:-fleet-site-cron:latest}"
WORKER_IMAGE="${FLEET_WORKER_IMAGE:-fleet-site-worker:latest}"

QUIET=0
ONLY=""
PROBE=0
for a in "$@"; do
  case "$a" in
    --quiet) QUIET=1 ;;
    # Actually START a worker from the shared image and confirm it dispatches.
    # Invoked with NO role, the site's worker entrypoint prints usage and exits
    # 2 before doing anything — so this exercises the image, the dispatcher,
    # the bind mounts and the compose wiring for FREE, with no Claude call and
    # no side effects. Off by default because it costs a container start per
    # site; on for rollout gates.
    --probe-worker) PROBE=1 ;;
    -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --*) echo "unknown flag: $a" >&2; exit 1 ;;
    *) ONLY="$a" ;;
  esac
done

pass=0; fail=0; pending=0
cur_site=""
_hdr() { (( QUIET )) && return 0; [[ -n "$cur_site" ]] && printf '\n\033[1m%s\033[0m\n' "$cur_site"; cur_site=""; }
ok()   { pass=$((pass+1)); (( QUIET )) && return 0; _hdr; printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { fail=$((fail+1)); _hdr; printf '  \033[31m✗\033[0m %s\n' "$1"; }
pend() { pending=$((pending+1)); (( QUIET )) && return 0; _hdr; printf '  \033[33m…\033[0m %s\n' "$1"; }
note() { (( QUIET )) && return 0; printf '    \033[2m%s\033[0m\n' "$1"; }

want_cron_id="$(docker image inspect --format '{{.Id}}' "$CRON_IMAGE" 2>/dev/null || true)"
want_worker_id="$(docker image inspect --format '{{.Id}}' "$WORKER_IMAGE" 2>/dev/null || true)"

# The two shared images must be built from the same VERSION. They are built by
# separate commands, so it is entirely possible to roll one and forget the
# other — and because workers are ephemeral, a stale worker image is invisible
# in `docker ps`. Checked once, fleet-wide, not per site.
image_version() { docker image inspect --format '{{index .Config.Labels "org.domains.fleet.version"}}' "$1" 2>/dev/null || true; }
check_image_versions() {
  local want cron_v worker_v
  want="$(tr -d '[:space:]' < "${IMAGES_DIR}/VERSION" 2>/dev/null || true)"
  cron_v="$(image_version "$CRON_IMAGE")"
  worker_v="$(image_version "$WORKER_IMAGE")"
  cur_site="shared images"
  if [[ -z "$cron_v" || -z "$worker_v" ]]; then
    pend "one of the shared images is missing locally (cron='${cron_v:-none}' worker='${worker_v:-none}')"
    return
  fi
  if [[ "$cron_v" == "$worker_v" ]]; then
    ok "cron and worker images are the same version (${cron_v})"
  else
    bad "shared images disagree: cron=${cron_v} worker=${worker_v} — one was rolled without the other"
  fi
  if [[ -n "$want" && "$cron_v" != "$want" ]]; then
    bad "built images are ${cron_v} but VERSION says ${want} — rebuild or correct VERSION"
  elif [[ -n "$want" ]]; then
    ok "images match VERSION (${want})"
  fi
}

# Cron-capable sites: a site with a compose file that defines a cron service.
# Derived from the filesystem, not a list, so it can't drift.
list_sites() {
  local d name
  for d in "${SITES_DIR}"/*/; do
    name="$(basename "$d")"
    [[ -f "${d}docker-compose.yml" ]] || continue
    grep -qE '^\s{2}cron:' "${d}docker-compose.yml" 2>/dev/null || continue
    [[ -n "$ONLY" && "$name" != "$ONLY" ]] && continue
    printf '%s\n' "$name"
  done
}

check_site() {
  local site="$1"
  local dir="${SITES_DIR}/${site}"
  local compose="${dir}/docker-compose.yml"
  local cname="${site%%.*}-cron"
  cur_site="$site"

  # ── 1. compose uses the shared cron image
  if grep -qE 'image:\s*fleet-site-cron:' "$compose" 2>/dev/null; then
    ok "compose references the shared cron image"
  else
    bad "compose does NOT reference fleet-site-cron — still a per-site image"
    note "migrate with: tools/fleet-images/bin/fleet-site-migrate ${site}"
    return
  fi

  # ── 2. no per-site cron Dockerfile left behind
  if [[ -f "${dir}/ops/docker/Dockerfile.cron" ]]; then
    bad "ops/docker/Dockerfile.cron still exists — it will drift again"
  else
    ok "no per-site Dockerfile.cron"
  fi

  # ── 3. crontab bind-mounted, not baked, and the SOURCE really exists
  local ct_src
  ct_src="$(grep -oE '\./[^:]*:/etc/crontab\.docker' "$compose" 2>/dev/null | head -1 | cut -d: -f1)"
  if [[ -n "$ct_src" ]]; then
    ok "crontab is bind-mounted (reschedule needs no rebuild)"
    # A bind mount whose source is missing is WORSE than no mount: docker
    # creates the source as a root-owned DIRECTORY inside the repo and
    # supercronic crash-loops on "is a directory". Caught on
    # broadwayshowgirls.com, whose file is named `crontab`, not
    # `crontab.docker`.
    if [[ -f "${dir}/${ct_src#./}" ]]; then
      ok "crontab source ${ct_src} exists as a file"
    else
      bad "crontab bind source ${ct_src} is missing or not a file — docker will create a root-owned directory there"
    fi
  else
    bad "crontab is NOT bind-mounted — schedules will silently diverge from the repo"
    note "this is the exact drift that left weapontester.com running a stale job for 4 days"
  fi

  # ── 4/5/6. the running container
  local status have_id uid
  status="$(docker inspect --format '{{.State.Status}}' "$cname" 2>/dev/null || echo absent)"
  if [[ "$status" == "running" ]]; then
    ok "container ${cname} is running"

    have_id="$(docker inspect --format '{{.Image}}' "$cname" 2>/dev/null || true)"
    if [[ -z "$want_cron_id" ]]; then
      pend "cannot compare image: ${CRON_IMAGE} not present locally"
    elif [[ "$have_id" == "$want_cron_id" ]]; then
      ok "running the current ${CRON_IMAGE}"
    else
      bad "running an OLDER image than ${CRON_IMAGE}"
      note "roll it: tools/fleet-images/bin/fleet-image-build cron --roll --sites ${site}"
    fi

    # Scheduling ZERO jobs means the container is up and doing nothing — which
    # looks identical to healthy in `docker ps`. Assert it actually loaded a
    # schedule.
    local sched
    sched="$(docker logs "$cname" 2>&1 | grep -oE 'scheduling [0-9]+ job' | tail -1 | grep -oE '[0-9]+' || true)"
    if [[ -z "$sched" ]]; then
      pend "could not read scheduled-job count from ${cname} logs"
    elif [[ "$sched" -gt 0 ]]; then
      ok "scheduler loaded ${sched} job(s)"
    else
      bad "scheduler loaded 0 jobs — container is up but doing nothing"
    fi

    uid="$(docker exec "$cname" id -u 2>/dev/null | tr -d '[:space:]')"
    if [[ "$uid" == "1000" ]]; then
      ok "runs as uid 1000 (never root)"
    elif [[ -z "$uid" ]]; then
      pend "could not read uid from ${cname}"
    else
      bad "runs as uid ${uid}, not 1000 — root writes into the mounted repo corrupt .git/objects"
    fi
  else
    bad "container ${cname} is ${status}"
  fi

  # ── 7/8. worker side
  if ! grep -qE '^\s{2}worker:' "$compose" 2>/dev/null; then
    ok "no worker service (scaffold) — worker checks not applicable"
    return
  fi
  if grep -qE 'image:\s*fleet-site-worker:' "$compose" 2>/dev/null; then
    ok "compose references the shared worker image"
    if compgen -G "${dir}/ops/docker/Dockerfile.worker*" >/dev/null 2>&1; then
      bad "ops/docker/Dockerfile.worker* still exists — it will drift again"
    else
      ok "no per-site Dockerfile.worker"
    fi
    if (( PROBE )); then
      local out rc
      # -T and </dev/null are BOTH load-bearing. `docker compose run` attaches
      # stdin by default; when this runs inside the site loop it swallows the
      # remaining site list, so the loop ends after the first site and
      # fleet-doctor reports a confident all-green having checked exactly one
      # of 26. A gate that silently stops early is worse than no gate.
      out="$( cd "$dir" && COMPOSE_PROFILES='*' timeout 300 docker compose run --rm --no-deps -T worker </dev/null 2>&1 )"
      rc=$?
      # Two independent signals, and deliberately NOT a specific exit code:
      #   1. our dispatcher line appears  -> the shared image booted, resolved
      #      this site's worker script, and handed off to it
      #   2. the exit is NON-ZERO         -> that script refused to do work
      #      without a role, i.e. it really ran
      #
      # An earlier version asserted `exit 2 + "usage"`, which was overfitting to
      # the majority convention: amputeenews.com's entrypoint exits 1 with
      # "role required" instead, and the probe called a perfectly healthy site
      # broken. The fleet has three worker-entrypoint conventions; the probe
      # must test that dispatch works, not that everyone words it the same.
      if grep -q 'dispatching to' <<<"$out" && [[ $rc -ne 0 ]]; then
        ok "worker starts from the shared image and dispatches (probe exit ${rc})"
      elif [[ $rc -eq 0 ]]; then
        bad "worker probe exited 0 with no role — it should have refused; the entrypoint may not have run at all"
        note "$(printf '%s' "$out" | tail -3 | tr '\n' ' ')"
      else
        bad "worker probe failed (exit ${rc}) — the shared image cannot run this site's worker"
        note "$(printf '%s' "$out" | tail -3 | tr '\n' ' ')"
      fi
    fi
  else
    pend "worker not yet migrated to ${WORKER_IMAGE} (expected until P2 completes)"
  fi
}

main() {
  local sites; sites="$(list_sites)"
  if [[ -z "$sites" ]]; then
    echo "fleet-doctor: no cron-capable sites found under ${SITES_DIR}"
    exit 0
  fi
  [[ -n "$want_cron_id" ]]   || printf '\033[33m[warn]\033[0m %s not built locally — image-currency checks will be skipped\n' "$CRON_IMAGE"

  # Read the site list on fd 3, not stdin: checks shell out to docker, and
  # anything that reads stdin would otherwise eat the rest of the list. Belt
  # and braces with the </dev/null on the probe above — this loop must be
  # impossible to truncate.
  local expected=0 checked=0
  expected="$(printf '%s\n' "$sites" | grep -c .)"
  check_image_versions
  while read -r -u 3 s; do
    [[ -n "$s" ]] || continue
    check_site "$s"
    checked=$((checked+1))
  done 3<<< "$sites"

  printf '\n\033[1mfleet-doctor: %d passed, %d failed, %d pending  (%d/%d sites checked)\033[0m\n' \
      "$pass" "$fail" "$pending" "$checked" "$expected"

  # Explicitly fail on an incomplete sweep. Reporting all-green after checking
  # 1 of 26 sites is exactly the failure this gate exists to prevent.
  if [[ "$checked" -ne "$expected" ]]; then
    printf '\033[31m[FATAL]\033[0m only %d of %d sites were checked — the sweep was truncated, treat this run as INVALID\n' "$checked" "$expected"
    return 1
  fi
  [[ "$fail" -eq 0 ]]
}

main
