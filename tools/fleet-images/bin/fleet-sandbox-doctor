#!/usr/bin/env bash
# Verify runtime prerequisites for model-authored content-writer sandboxes.
set -uo pipefail
IMAGE="${FLEET_WORKER_IMAGE:-fleet-site-worker:latest}"
JSON=0
[[ "${1:-}" == "--json" ]] && JSON=1
declare -a checks=()
declare -a details=()
add_check() { checks+=("$1"); details+=("$2"); }

if command -v bwrap >/dev/null 2>&1; then add_check pass "bubblewrap installed: $(command -v bwrap)"; else add_check fail "bubblewrap is not installed"; fi
if command -v unshare >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; then add_check pass "unprivileged user namespaces work"; else add_check fail "unprivileged user namespaces are unavailable"; fi
if [[ -r /proc/sys/user/max_user_namespaces ]] && [[ "$(cat /proc/sys/user/max_user_namespaces)" =~ ^[0-9]+$ ]] && (( $(cat /proc/sys/user/max_user_namespaces) > 0 )); then add_check pass "user.max_user_namespaces=$(cat /proc/sys/user/max_user_namespaces)"; else add_check fail "user.max_user_namespaces is unavailable or zero"; fi
if command -v docker >/dev/null 2>&1 && docker image inspect "$IMAGE" >/dev/null 2>&1; then
  if docker run --rm --security-opt=seccomp=unconfined --security-opt=apparmor=unconfined --entrypoint sh "$IMAGE" -c 'exec 9</dev/null; exec bwrap --unshare-user --die-with-parent --new-session --unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /sbin /sbin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind /etc /etc --ro-bind /opt /opt --ro-bind /proc /proc --tmpfs /dev --perms 0666 --file 9 /dev/null --dir /dev/shm --tmpfs /tmp /usr/local/bin/claude --version' >/dev/null 2>&1; then add_check pass "worker image sandbox smoke passed: $IMAGE"; else add_check fail "worker image sandbox smoke failed: $IMAGE"; fi
else add_check warn "worker image unavailable; skipped container smoke: $IMAGE"; fi
failed=0
for result in "${checks[@]}"; do [[ "$result" == fail ]] && failed=$((failed + 1)); done
if (( JSON )); then
  printf '{"ok":%s,"failed":%d,"checks":[' "$([[ $failed -eq 0 ]] && echo true || echo false)" "$failed"
  for i in "${!checks[@]}"; do (( i )) && printf ','; printf '{"status":"%s","detail":"%s"}' "${checks[$i]}" "${details[$i]//\"/\\\"}"; done
  printf ']}\n'
else
  printf '[fleet-sandbox-doctor] %s\n' "$([[ $failed -eq 0 ]] && echo PASS || echo FAIL)"
  for i in "${!checks[@]}"; do printf '  %s %s\n' "${checks[$i]}" "${details[$i]}"; done
fi
(( failed == 0 ))
