#!/usr/bin/env bash
# fleet-site-migrate <site> [--cron|--worker|--both] [--harden] [--dry-run] [--revert]
#
# Move ONE site off its bespoke images and onto the shared fleet images.
#
# Edits that site's docker-compose.yml in place:
#   cron service    build: {context,dockerfile}  ->  image: fleet-site-cron:latest
#                   + bind-mount ops/docker/crontab.docker at /etc/crontab.docker
#                   + SITE_NAME / FLEET_WORKER_IMAGE env
#   worker service  build: {context,dockerfile}  ->  image: fleet-site-worker:latest
#
# and deletes the now-dead ops/docker/Dockerfile.{cron,worker}.
#
# WHY A SCRIPT AND NOT 27 HAND EDITS: the hand-edit path is exactly how the
# fleet got 53 divergent files. It is also why this is per-site and explicit
# rather than a "migrate everything" button — Jesse's standing rule is that
# fleet rollouts stay deliberate, reviewed and canaried, so the wave structure
# lives in the operator's head and the command, not in a loop inside a tool.
#
# A .bak of the compose file is kept so --revert is always available for the
# canary. It is written OUTSIDE the site repo (under $FLEET_MIGRATE_BAKDIR,
# default /tmp/fleet-site-migrate) on purpose: every site is a git submodule
# and the fleet's deploy roles run `git add -A`, so a stray .bak next to the
# compose file would be committed and pushed. Every site is a submodule, so
# `git -C sites/<site> diff` is the real review surface — read it before
# committing.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="$(cd "${HERE}/.." && pwd)"
DOMAINS_ROOT="${FLEET_DOMAINS_ROOT:-$(cd "${IMAGES_DIR}/../.." && pwd)}"

SITE="${1:-}"
[[ -n "$SITE" && "$SITE" != -* ]] || { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
shift

DO_CRON=1; DO_WORKER=1; DRY=0; REVERT=0; HARDEN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cron)    DO_CRON=1; DO_WORKER=0 ;;
    --worker)  DO_CRON=0; DO_WORKER=1 ;;
    --both)    DO_CRON=1; DO_WORKER=1 ;;
    --harden)  HARDEN=1 ;;
    --dry-run) DRY=1 ;;
    --revert)  REVERT=1 ;;
    *) echo "unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done

DIR="${DOMAINS_ROOT}/sites/${SITE}"
COMPOSE="${DIR}/docker-compose.yml"
[[ -f "$COMPOSE" ]] || { echo "no docker-compose.yml for ${SITE}" >&2; exit 1; }

BAKDIR="${FLEET_MIGRATE_BAKDIR:-/tmp/fleet-site-migrate}"
BAK="${BAKDIR}/${SITE}.docker-compose.yml.bak"
mkdir -p "$BAKDIR"

if (( REVERT )); then
  [[ -f "$BAK" ]] || { echo "no backup at ${BAK} to revert from" >&2; exit 1; }
  cp -f "$BAK" "$COMPOSE"
  echo "[migrate] reverted ${SITE} compose from ${BAK}"
  echo "[migrate] deleted Dockerfiles come back with: git -C ${DIR} checkout -- ops/docker"
  exit 0
fi

export FM_SITE="$SITE" FM_COMPOSE="$COMPOSE" FM_DIR="$DIR" FM_BAK="$BAK" \
       FM_DO_CRON="$DO_CRON" FM_DO_WORKER="$DO_WORKER" FM_DRY="$DRY" FM_HARDEN="$HARDEN"

python3 <<'PYEOF'
import os, re, shutil, sys

site      = os.environ['FM_SITE']
compose   = os.environ['FM_COMPOSE']
site_dir  = os.environ['FM_DIR']
do_cron   = os.environ['FM_DO_CRON'] == '1'
do_worker = os.environ['FM_DO_WORKER'] == '1'
dry       = os.environ['FM_DRY'] == '1'
harden    = os.environ['FM_HARDEN'] == '1'
slug      = site.split('.')[0]

src = open(compose).read()
out = src
changes = []

def service_span(text, name):
    """Byte span of one top-level service block under `services:`.

    Hand-rolled rather than yaml.load+dump on purpose: these compose files
    carry a lot of load-bearing commentary (why a mount is :ro, which incident
    a flag came from) and a YAML round-trip would silently delete all of it.
    Preserving those comments is worth a careful regex.
    """
    m = re.search(rf'^  {re.escape(name)}:[ \t]*$', text, re.M)
    if not m:
        return None
    start = m.start()
    nxt = re.search(r'^  [A-Za-z0-9_-]+:[ \t]*$|^[A-Za-z0-9_-]+:', text[m.end():], re.M)
    end = m.end() + nxt.start() if nxt else len(text)
    return start, end

def swap_build_for_image(block, image, svc):
    """Replace a `build:` mapping with `image: <shared>`, keeping any existing
    `image:` line's position so the diff stays small and readable."""
    # Drop the build: block (its indented children included).
    nb = re.sub(r'\n[ \t]{4}build:[ \t]*\n(?:[ \t]{6,}.*\n)*', '\n', block)
    if nb == block and 'build:' in block:
        return block, False
    # Replace an existing image: line, or insert one right after the service key.
    if re.search(r'\n[ \t]{4}image:[ \t]*\S+', nb):
        nb = re.sub(r'\n[ \t]{4}image:[ \t]*\S+', f'\n    image: {image}', nb, count=1)
    else:
        nb = re.sub(rf'(^  {re.escape(svc)}:[ \t]*\n)', rf'\1    image: {image}\n', nb, count=1, flags=re.M)
    return nb, True

def ensure_line_in_block(block, anchor_re, line, dedupe_re):
    """Insert `line` under the mapping matched by `anchor_re` if absent."""
    if re.search(dedupe_re, block):
        return block, False
    m = re.search(anchor_re, block, re.M)
    if not m:
        return block, False
    return block[:m.end()] + line + block[m.end():], True

# ── cron service ────────────────────────────────────────────────────────────
if do_cron:
    span = service_span(out, 'cron')
    if not span:
        print(f"[migrate] {site}: no cron service — skipping cron", file=sys.stderr)
    else:
        s, e = span
        blk = out[s:e]
        blk, did = swap_build_for_image(blk, 'fleet-site-cron:latest', 'cron')
        if did:
            changes.append('cron: build -> fleet-site-cron:latest')

        # The load-bearing part of the whole migration: unbake the crontab.
        #
        # RESOLVE the real filename — do NOT assume it. Docker's bind-mount
        # semantics make a wrong guess quietly destructive: if the source path
        # doesn't exist the daemon CREATES IT, as a ROOT-OWNED DIRECTORY, inside
        # the site repo. supercronic then dies with "is a directory" and the
        # container crash-loops. broadwayshowgirls.com names its file
        # `ops/docker/crontab` (no .docker suffix) and hit exactly this.
        # Only resolve (and require) a crontab when we are actually about to add
        # the mount. On an already-migrated site — e.g. a --harden pass — the
        # mount is present and this must not run at all, or the guard below
        # aborts a perfectly valid edit on a site that is already correct.
        already_mounted = re.search(r':/etc/crontab\.docker', blk) is not None
        crontab_rel = None
        if not already_mounted:
            for cand in ('ops/docker/crontab.docker', 'ops/docker/crontab'):
                if os.path.isfile(os.path.join(site_dir, cand)):
                    crontab_rel = cand
                    break
        if crontab_rel is None and not already_mounted:
            print(f"[migrate] {site}: FATAL — no crontab found at ops/docker/crontab.docker "
                  f"or ops/docker/crontab. Refusing to add a bind mount for a path that "
                  f"does not exist (docker would create a root-owned directory there).",
                  file=sys.stderr)
            sys.exit(2)

        blk, did = (blk, False) if already_mounted else ensure_line_in_block(
            blk, r'^[ \t]{4}volumes:[ \t]*$',
            '\n      # Crontab is BIND-MOUNTED, never baked into the image: editing\n'
            f'      # {crontab_rel} and restarting this container is the whole\n'
            '      # reschedule procedure. Baking it is what let schedules silently\n'
            '      # diverge from the repo for days at a time.\n'
            f'      - ./{crontab_rel}:/etc/crontab.docker:ro',
            r':/etc/crontab\.docker')
        if did:
            changes.append(f'cron: crontab bind-mounted from {crontab_rel}')

        # SITE_NAME lets the shared entrypoint identify itself in logs;
        # FLEET_WORKER_IMAGE tells it which worker image to pre-resolve, so the
        # cron migration does not depend on the worker migration having happened.
        worker_img = 'fleet-site-worker:latest' if 'fleet-site-worker' in out or do_worker else f'{slug}-worker:latest'
        blk, did = ensure_line_in_block(
            blk, r'^[ \t]{4}environment:[ \t]*$',
            f'\n      SITE_NAME: {site}\n      FLEET_WORKER_IMAGE: {worker_img}',
            r'SITE_NAME:')
        if did:
            changes.append(f'cron: SITE_NAME + FLEET_WORKER_IMAGE={worker_img}')
        out = out[:s] + blk + out[e:]

# ── worker service(s) ───────────────────────────────────────────────────────
# Plural: broadwayshowgirls.com runs TWO one-shot workers side by side —
# `worker` (its local-Ollama writer) and `claude-worker` (the fleet-standard
# claude-code roles). Both are one-shot `run --rm` containers and both want the
# shared image, so migrating only the one named exactly "worker" would leave a
# bespoke Dockerfile.worker.claude behind and defeat the point for that site.
WORKER_SERVICES = ('worker', 'claude-worker')

for _svc in (WORKER_SERVICES if do_worker else ()):
    span = service_span(out, _svc)
    if not span:
        continue
    if True:
        s, e = span
        blk = out[s:e]
        blk, did = swap_build_for_image(blk, 'fleet-site-worker:latest', _svc)
        if did:
            changes.append(f'{_svc}: build -> fleet-site-worker:latest')
        # A site that mounts its repo somewhere other than /work needs the
        # dispatcher pointed at it (broadwayshowgirls uses /repo).
        if re.search(r'^\s+-\s+\.:/repo\b', blk, re.M):
            blk, did2 = ensure_line_in_block(
                blk, r'^[ \t]{4}environment:[ \t]*$',
                '\n      FLEET_WORKER_ROOT: /repo', r'FLEET_WORKER_ROOT:')
            if did2:
                changes.append(f'{_svc}: FLEET_WORKER_ROOT=/repo')
        # SPLICE EXACTLY ONCE, after every edit to this block.
        #
        # The earlier version spliced after the build swap and then spliced a
        # SECOND time using the original `e`. By then `out` had already shrunk
        # by the length of the removed build: block, so `out[e:]` began that
        # many characters too late and silently ate the head of the NEXT
        # service. On broadwayshowgirls.com (which has a third service,
        # claude-worker) that turned `dockerfile: ops/docker/...` into
        # `ocker/...` and produced invalid YAML. Any offset captured before an
        # edit is stale after it — collect edits, splice once.
        out = out[:s] + blk + out[e:]

# ── runtime hardening ───────────────────────────────────────────────────────
# Applied to both the scheduler and the one-shot workers. Every value below was
# verified NOT to break the fleet before being written (astro build incl. a
# 1156-page site, Playwright chromium launch, sharp, git, and the cron
# container driving the docker socket, all with ALL capabilities dropped).
#
# cap_drop: ALL — nothing here needs a single Linux capability. The worker
#   builds sites and runs a browser; the scheduler talks to a unix socket.
#   Dropping all of them costs nothing and removes the whole capability-based
#   escalation surface from a container that executes model-authored code.
# no-new-privileges — blocks setuid escalation even if a setuid binary
#   reappears in a future base image (the worker image also clears the bits).
# pids_limit — a fork bomb in one role cannot take the host down with it.
# mem_limit — one runaway build cannot starve the other 25 sites. Deliberately
#   generous: the heaviest measured build peaks well under a tenth of this.
HARDENING = {
    'cron':   [('cap_drop', ['ALL']), ('pids_limit', '512'),  ('mem_limit', '1g')],
    'worker': [('cap_drop', ['ALL']), ('pids_limit', '2048'), ('mem_limit', '8g')],
}

def harden_service(text, svc, kind):
    sp = service_span(text, svc)
    if not sp:
        return text, []
    s0, e0 = sp
    blk = text[s0:e0]
    done = []

    # no-new-privileges lives under security_opt; add the whole key if absent.
    if 'no-new-privileges' not in blk:
        if re.search(r'^[ \t]{4}security_opt:[ \t]*$', blk, re.M):
            blk, did = ensure_line_in_block(
                blk, r'^[ \t]{4}security_opt:[ \t]*$',
                '\n      - no-new-privileges:true', r'no-new-privileges')
        else:
            blk, did = ensure_line_in_block(
                blk, rf'^  {re.escape(svc)}:[ \t]*$',
                '\n    security_opt:\n      - no-new-privileges:true', r'no-new-privileges')
        if did:
            done.append(f'{svc}: no-new-privileges')

    for key, val in HARDENING[kind]:
        if re.search(rf'^[ \t]{{4}}{key}:', blk, re.M):
            continue
        if isinstance(val, list):
            ins = f'\n    {key}:\n' + '\n'.join(f'      - {v}' for v in val)
        else:
            ins = f'\n    {key}: {val}'
        blk, did = ensure_line_in_block(
            blk, rf'^  {re.escape(svc)}:[ \t]*$', ins, rf'^[ \t]{{4}}{key}:')
        if did:
            done.append(f'{svc}: {key}')

    return text[:s0] + blk + text[e0:], done

if harden:
    # cap_drop on the cron service is safe: it drives the docker socket, which
    # needs group membership, not capabilities. Verified empirically.
    out, d = harden_service(out, 'cron', 'cron')
    changes.extend(d)
    for _svc in WORKER_SERVICES:
        out, d = harden_service(out, _svc, 'worker')
        changes.extend(d)

if do_worker and not any(c.split(':')[0] in WORKER_SERVICES for c in changes):
    print(f"[migrate] {site}: no worker service to migrate", file=sys.stderr)

if not changes:
    print(f"[migrate] {site}: already migrated / nothing to change")
    sys.exit(0)

if dry:
    print(f"[migrate] {site} (DRY RUN) would apply:")
    for c in changes:
        print(f"           - {c}")
    import difflib
    for line in list(difflib.unified_diff(src.splitlines(), out.splitlines(),
                                          'before', 'after', lineterm=''))[:80]:
        print('    ' + line)
    sys.exit(0)

shutil.copy2(compose, os.environ['FM_BAK'])
open(compose, 'w').write(out)
print(f"[migrate] {site}: compose updated ({len(changes)} change(s)); backup at {os.environ['FM_BAK']}")
for c in changes:
    print(f"           - {c}")

# Deleting the Dockerfiles is deliberately NOT done here. It happens in the
# shell below, only AFTER `docker compose config` proves the rewritten file is
# valid. Doing it here removed them first and then reverted the compose on a
# validation failure, leaving the site with a good compose that referenced
# Dockerfiles that no longer existed — a worse state than either outcome.
PYEOF

rc=$?
(( DRY )) && exit $rc
[[ $rc -eq 0 ]] || exit $rc

echo "[migrate] validating compose syntax..."
if ! ( cd "$DIR" && COMPOSE_PROFILES='*' docker compose config >/dev/null ); then
  # Keep the broken output for inspection — a revert that also destroys the
  # evidence makes the next failure just as opaque as this one.
  cp -f "$COMPOSE" "${BAK}.invalid"
  cp -f "$BAK" "$COMPOSE"
  echo "[migrate] ✗ ${SITE} compose is INVALID — reverted; broken version kept at ${BAK}.invalid"
  exit 1
fi
echo "[migrate] ✓ ${SITE} compose is valid"

# Only now is it safe to drop the per-site Dockerfiles.
for kind in cron worker; do
  case "$kind" in
    cron)   (( DO_CRON ))   || continue ;;
    worker) (( DO_WORKER )) || continue ;;
  esac
  # Also catches suffixed variants like Dockerfile.worker.claude, which
  # broadwayshowgirls.com used for its second worker service.
  for df in "${DIR}/ops/docker/Dockerfile.${kind}" "${DIR}/ops/docker/Dockerfile.${kind}".*; do
    [[ -f "$df" ]] || continue
    rm -f "$df"
    echo "[migrate]            - removed ops/docker/$(basename "$df")"
  done
done
