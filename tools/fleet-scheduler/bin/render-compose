#!/usr/bin/env python3
"""Render docker-compose.generated.yml: the scheduler container plus, per site, the two
file/dir overlays each legacy cron container had (broker-rendered .env.shared and the
.monorepo-tools view of tools/). Same absolute paths as the host so `docker compose run`
inside a job resolves bind sources identically.

Refuses to emit a mount whose mountpoint doesn't already exist: docker would create it
as root, which is exactly how root-owned dirs got into site repos before.
"""
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
ROOT = Path(os.environ.get("FS_ROOT", HERE.parent.parent))
HOME = os.environ.get("HOME", "/home/jesse")
sites = sorted(p.parent.parent.parent.name for p in (ROOT / "sites").glob("*/ops/docker/crontab.docker"))

import re
import yaml


def expand(s: str, site_dir: Path) -> str:
    def rep(m):
        name, default = m.group(1), m.group(2)
        val = {"HOME": HOME, "PWD": str(site_dir)}.get(name) or os.environ.get(name)
        return val if val else (default if default is not None else "")
    return re.sub(r"\$\{(\w+)(?::-([^}]*))?\}", rep, s)


# Per-site extras the legacy cron services carried beyond the standard set (git-store mounts,
# shared deploy lock, rendered secrets, extra networks, extra_hosts). Derived, never hand-listed.
extra_vols: dict[str, tuple[str, str]] = {}   # target -> (source, mode)
extra_nets: dict[str, str] = {}               # compose key -> external network name
extra_hosts: set[str] = set()
conflicts = []
for s in sites:
    sd = ROOT / "sites" / s
    try:
        doc = yaml.safe_load((sd / "docker-compose.yml").read_text()) or {}
    except Exception as e:  # noqa: BLE001
        conflicts.append(f"{s}: compose unreadable ({e})")
        continue
    cron = (doc.get("services") or {}).get("cron") or {}
    std_targets = {"/etc/crontab.docker", "/var/run/docker.sock", str(sd), f"{HOME}/.docker",
                   f"{sd}/.env.shared", f"{sd}/.monorepo-tools"}
    for v in cron.get("volumes") or []:
        if not isinstance(v, str):
            continue
        parts = expand(v, sd).split(":")  # expand first: ${HOME:-/x} contains a colon
        if len(parts) < 2 or parts[1] in std_targets:
            continue
        src = parts[0] if parts[0].startswith("/") else str((sd / parts[0]).resolve())
        mode = parts[2] if len(parts) > 2 else "rw"
        if parts[1] in extra_vols and extra_vols[parts[1]][0] != src:
            conflicts.append(f"{s}: mount target {parts[1]} conflicts with another site's source")
            continue
        extra_vols[parts[1]] = (src, mode)
    for n in cron.get("networks") or []:
        if n in ("ops", "default"):
            continue
        nd = (doc.get("networks") or {}).get(n) or {}
        extra_nets[n] = nd.get("name") or n
    extra_hosts.update(cron.get("extra_hosts") or [])

vols, skipped = [], []
for tgt, (src, mode) in sorted(extra_vols.items()):
    vols.append(f"      - {src}:{tgt}" + (":ro" if mode == "ro" else ""))
for s in sites:
    env = ROOT / "tools/env-broker/rendered" / f"{s}.env"
    sd = ROOT / "sites" / s
    if not env.is_file() or not (sd / ".env.shared").exists() or not (sd / ".monorepo-tools").is_dir():
        skipped.append((s, f"missing env={env.is_file()} mp_env={(sd/'.env.shared').exists()} mp_tools={(sd/'.monorepo-tools').is_dir()}"))
        continue
    vols.append(f"      - {env}:{sd}/.env.shared:ro")
    vols.append(f"      - {ROOT}/tools:{sd}/.monorepo-tools:ro")

out = f"""# GENERATED by bin/render-compose — do not edit. {len(sites) - len(skipped)} sites.
name: fleet-scheduler

services:
  scheduler:
    build: .
    image: fleet-scheduler:latest
    container_name: fleet-scheduler
    restart: unless-stopped
    init: true                 # PID 1 reaps the grandchildren that jobs orphan
    stop_grace_period: 40s
    read_only: true
    tmpfs:
      - /tmp:size=512m,uid=1000,mode=1777
      - /run:size=16m,uid=1000
      - {HOME}:size=256m,uid=1000,mode=0755
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 48g
    pids_limit: 8192
    group_add:
      - "${{DOCKER_GID:?run bin/fleet-scheduler so the Docker socket GID is detected}}"
    ports:
      - "127.0.0.1:4790:4790"
    environment:
      FS_ROOT: {ROOT}
      FS_TOKEN_FILE: /run/secrets/scheduler-token
      FLEET_SCHEDULER: "1"
      HOME: {HOME}
      TZ: America/New_York
      FLEET_WORKER_IMAGE: fleet-site-worker:latest
    logging:
      driver: json-file
      options: {{max-size: "20m", max-file: "5"}}
    networks: [{", ".join(["control", *sorted(extra_nets)])}]
{"    extra_hosts:" + chr(10) + chr(10).join(f"      - {h}" for h in sorted(extra_hosts)) if extra_hosts else ""}
    volumes:
      - {HERE}/data:/data
      - {HERE}/data/token:/run/secrets/scheduler-token:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - {HOME}/.docker:{HOME}/.docker
      - {ROOT}/sites:{ROOT}/sites
{chr(10).join(vols)}
    working_dir: /data

networks:
  control:
    external: true
    name: fleet-control
{chr(10).join(f"  {k}:{chr(10)}    external: true{chr(10)}    name: {v}" for k, v in sorted(extra_nets.items()))}
"""
(HERE / "docker-compose.generated.yml").write_text(out)
print(f"rendered {len(sites) - len(skipped)} sites", file=sys.stderr)
print(f"extras: {len(extra_vols)} mounts, networks={sorted(extra_nets.values())}, extra_hosts={sorted(extra_hosts)}", file=sys.stderr)
for c in conflicts:
    print(f"WARNING {c}", file=sys.stderr)
for s, why in skipped:
    print(f"SKIPPED {s}: {why}", file=sys.stderr)
