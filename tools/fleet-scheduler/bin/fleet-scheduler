#!/usr/bin/env bash
# Operator entrypoint for the fleet scheduler.
#   fleet-scheduler up            render mounts, build, start (idempotent; creates token + network)
#   fleet-scheduler down|logs|status|jobs [site]|runs [site]
#   fleet-scheduler import [site...]   load legacy crontab.docker files (idempotent, never fires)
#   fleet-scheduler adopt <site>       CUTOVER: stop legacy cron container -> fire from DB -> remove legacy (atomic, in-service)
#   fleet-scheduler release <site>     ROLLBACK: stop firing from DB, restart the legacy cron container
#   fleet-scheduler run <site> <job>   run a job now (manual trigger)
#   fleet-scheduler pause|resume       global kill switch (running jobs finish)
#   fleet-scheduler drain              pause + wait for running jobs to finish (used by `up` for safe deploys)
#   FS_API=http://127.0.0.1:4791 FS_TOKEN_FILE=tools/fleet-cron/data/token  -> same CLI against the fleet-tools instance
#   fleet-scheduler mirror-check   verify DB jobs are still represented in legacy crontabs
#   fleet-scheduler api <METHOD> <path> [json]
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${FS_ROOT:-$(cd "$HERE/../.." && pwd)}"
export FS_ROOT="$ROOT"
COMPOSE=(docker compose -f "$HERE/docker-compose.generated.yml")
API="${FS_API:-http://127.0.0.1:4790}"

token() { cat "${FS_TOKEN_FILE:-$HERE/data/token}"; }
api() { # method path [json]
  local m="$1" p="$2" body="${3:-}"
  curl -fsS -X "$m" -H "Authorization: Bearer $(token)" -H "X-Actor: ${USER:-operator}" \
       -H 'Content-Type: application/json' ${body:+-d "$body"} "$API$p"
}
# Safe-deploy drain: pause (nothing new starts), wait for in-flight jobs to finish so a restart
# never kills a running Claude role. Leaves the scheduler paused; caller resumes.
drain() {
  # Preferred: stop only NEW heavy (Claude/worker) work; watchdogs/deployers keep running. Falls back to
  # a full pause against an older scheduler that doesn't know drain_heavy yet.
  DRAIN_MODE=drain_heavy
  api PATCH /api/settings '{"drain_heavy":true}' >/dev/null 2>&1 || { DRAIN_MODE=paused; api PATCH /api/settings '{"paused":true}' >/dev/null; }
  local deadline=$(( $(date +%s) + ${FS_DRAIN_TIMEOUT:-1800} )) n
  while :; do
    if [ "$DRAIN_MODE" = drain_heavy ]; then
      n="$(api GET '/api/runs?status=running&limit=200' | python3 -c 'import sys,json;print(sum(1 for r in json.load(sys.stdin) if r["class"]=="heavy"))')"
    else
      n="$(api GET /api/status | python3 -c 'import sys,json;print(json.load(sys.stdin)["running"])')"
    fi
    [ "$n" = 0 ] && return 0
    [ "$(date +%s)" -ge "$deadline" ] && { echo "drain timeout: $n still running" >&2; return 1; }
    echo "draining ($DRAIN_MODE): $n job(s) still running…" >&2; sleep 15
  done
}
undrain() { api PATCH /api/settings '{"drain_heavy":false,"paused":false}' >/dev/null 2>&1 || api PATCH /api/settings '{"paused":false}' >/dev/null; }
site_id() { api GET "/api/jobs?site=$1" | python3 -c "import sys,json;j={x['name']:x['id'] for x in json.load(sys.stdin)};print(j['$2'])"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  up)
    mkdir -p "$HERE/data"
    docker network inspect fleet-control >/dev/null 2>&1 || docker network create fleet-control >/dev/null
    if [[ ! -s "$HERE/data/token" ]]; then
      (umask 077; python3 -c 'import secrets;print(secrets.token_urlsafe(32))' > "$HERE/data/token")
      chmod 0400 "$HERE/data/token"
    fi
    export DOCKER_GID="$(stat -c %g /var/run/docker.sock)"
    "$HERE/bin/render-compose"
    "${COMPOSE[@]}" build
    was_running=0
    if [ -z "${FS_NO_DRAIN:-}" ] && api GET /api/status >/dev/null 2>&1; then
      was_running=1
      drain || { undrain; echo "aborted: not restarting while jobs run (FS_NO_DRAIN=1 to force)" >&2; exit 1; }
    fi
    "${COMPOSE[@]}" up -d --remove-orphans
    if [ "$was_running" = 1 ]; then
      for _ in $(seq 1 30); do api GET /api/status >/dev/null 2>&1 && break; sleep 2; done
      undrain && echo "resumed after restart"
    fi ;;
  drain)  drain && echo "drained (new heavy work blocked — run: fleet-scheduler resume)" ;;
  down)   "${COMPOSE[@]}" down ;;
  logs)   "${COMPOSE[@]}" logs -f --tail=100 scheduler ;;
  status) api GET /api/status | python3 -m json.tool ;;
  mirror-check)
    result="$(api GET /api/mirror-check)"
    printf '%s\n' "$result" | python3 -m json.tool
    printf '%s\n' "$result" | python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin)["ok"] else 1)' ;;
  jobs)   api GET "/api/jobs${1:+?site=$1}" | python3 -c "
import sys,json,datetime
for j in json.load(sys.stdin):
    lr=j['last_run'] or {}
    nf=datetime.datetime.fromtimestamp(j['next_fire']).strftime('%m-%d %H:%M') if j['next_fire'] else '-'
    print(f\"{j['id']:>4} {j['site']:<24} {j['name']:<22} {j['schedule']:<20} {j['class']:<5} {'ON ' if j['active'] else 'off'} next={nf} last={lr.get('status','-')}\")" ;;
  runs)   api GET "/api/runs?limit=40${1:+&site=$1}" | python3 -c "
import sys,json,datetime
for r in json.load(sys.stdin):
    t=datetime.datetime.fromtimestamp(r['queued_at']).strftime('%m-%d %H:%M:%S')
    print(f\"{r['id']:>6} {t} {r['site']:<22} {r['name']:<20} {r['status']:<16} exit={r['exit_code']} {r['note'] or ''}\")" ;;
  import)
    docker exec fleet-scheduler python3 -m fleetsched import "$@"
    api POST /api/reload >/dev/null && echo reloaded ;;
  adopt)   api POST "/api/sites/${1:?site}/adopt" | python3 -m json.tool ;;
  release) api POST "/api/sites/${1:?site}/release" | python3 -m json.tool ;;
  run)    id="$(site_id "$1" "$2")"; api POST "/api/jobs/$id/run" ;;
  pause)  api PATCH /api/settings '{"paused":true}' >/dev/null && echo paused ;;
  resume) undrain && echo resumed ;;
  api)    api "$@" ;;
  *) sed -n '2,13p' "${BASH_SOURCE[0]}"; exit 2 ;;
esac
