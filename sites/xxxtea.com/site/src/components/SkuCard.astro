---
import type { Sku } from '@/lib/affiliate';
import { FORMS, VARIETALS } from '@/lib/affiliate';

interface Props {
  sku: Sku;
  variant?: 'compact' | 'full';
}

const { sku, variant = 'compact' } = Astro.props;
const tierLabel = sku.priceTier === 'pro' ? 'Pro' : sku.priceTier === 'mid' ? 'Mid' : 'Budget';
const imgSrc = `/gallery/${sku.image}-1200.webp`;
const varietalLabel = sku.varietal !== 'none' ? VARIETALS[sku.varietal]?.label : null;
---
<article class="card flex flex-col overflow-hidden group">
  <a href={`/reviews/${sku.id}/`} class="block relative aspect-[4/5] overflow-hidden bg-steep-800 no-underline">
    <img src={imgSrc} alt=""
         class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
         loading="lazy" decoding="async"/>
    <div class="absolute inset-0 bg-gradient-to-t from-steep-900/85 via-steep-900/20 to-transparent"></div>
    <div class="absolute top-3 left-3 flex items-center gap-2">
      <span class="eyebrow bg-steep-900/80 backdrop-blur-sm px-2 py-1 rounded-sm">{FORMS[sku.form].label}</span>
    </div>
    <div class="absolute top-3 right-3">
      <span class="text-xs font-mono text-porcelain bg-steep-900/80 backdrop-blur-sm px-2 py-1 rounded-sm">{tierLabel}</span>
    </div>
    {varietalLabel && (
      <div class="absolute bottom-3 left-3">
        <span class="font-mono text-xs text-steep-900 bg-honey-500/95 px-2 py-1 rounded-sm">{varietalLabel}</span>
      </div>
    )}
  </a>
  <div class="p-5 flex flex-col gap-3 grow">
    <h3 class="font-display text-2xl text-porcelain leading-snug">
      <a href={`/reviews/${sku.id}/`} class="no-underline hover:text-honey-400">{sku.name}</a>
    </h3>
    <p class="text-steep-100 text-sm">{sku.pitch}</p>
    {variant === 'full' && (
      <p class="text-steep-300 text-sm italic">{sku.blurb}</p>
    )}
    <div class="flex items-center gap-2 mt-auto pt-2">
      <a href={`/go/${sku.id}`} rel="sponsored noopener noreferrer" target="_blank" class="btn-primary text-xs py-2 px-3">
        View on Amazon ↗
      </a>
      <a href={`/reviews/${sku.id}/`} class="btn-ghost text-xs py-2 px-3">Read review</a>
    </div>
  </div>
</article>
