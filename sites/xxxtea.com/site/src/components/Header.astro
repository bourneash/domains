---
const nav = [
  { href: '/reviews/',    label: 'Reviews' },
  { href: '/varietals/',  label: 'Varietals' },
  { href: '/vessels/',    label: 'Vessels' },
  { href: '/brewing/',    label: 'Brewing' },
  { href: '/gallery/',    label: 'Gallery' },
  { href: '/about/',      label: 'About' },
];
---
<header class="border-b border-steep-700 bg-steep-900/80 backdrop-blur sticky top-0 z-30">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-6">
    <a href="/" class="no-underline group inline-flex items-end" aria-label="xxxtea home">
      <span class="inline-block">
        <span class="wordmark-xxx text-3xl leading-none">xxx</span>
        <span class="wordmark-underbar"></span>
      </span>
      <span class="wordmark-tea text-3xl leading-none ml-0.5">tea</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm">
      {nav.map((n) => (
        <a href={n.href} class="text-steep-100 no-underline hover:text-honey-400">{n.label}</a>
      ))}
    </nav>
    <a href="/brewing/" class="btn-primary text-sm py-2 px-4">Find your brew</a>
  </div>
</header>
