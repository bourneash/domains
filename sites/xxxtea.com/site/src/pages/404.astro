---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page not found | xxxtea" noIndex>
  <section class="max-w-2xl mx-auto px-6 py-32 text-center">
    <p class="font-mono text-honey-500 text-6xl">404</p>
    <h1 class="font-display text-4xl md:text-5xl text-porcelain mt-4">Couldn't find that page.</h1>
    <p class="mt-4 text-steep-300">It steeped too long and lost itself.</p>
    <div class="mt-10 flex justify-center gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/reviews/" class="btn-ghost">Browse reviews</a>
    </div>
  </section>
</BaseLayout>
