---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkuCard from '@/components/SkuCard.astro';
import { SKUS, VARIETALS, BROWSABLE_VARIETALS, type Varietal } from '@/lib/affiliate';

export async function getStaticPaths() {
  return BROWSABLE_VARIETALS.map((v) => ({
    params: { slug: v },
    props: { varietal: v },
  }));
}

interface Props { varietal: Exclude<Varietal, 'none'> }
const { varietal } = Astro.props as Props;
const meta = VARIETALS[varietal];
const items = SKUS.filter((s) => s.varietal === varietal);

const title = `${meta.label} tea — xxxtea`;
const description = `${meta.tagline} Brew at ${meta.brewTemp} for ${meta.brewTime}. ${items.length} SKUs reviewed.`;
---
<BaseLayout title={title} description={description}>
  <section class="border-b border-steep-700">
    <div class="max-w-4xl mx-auto px-6 py-20 md:py-28">
      <p class="eyebrow mb-3">By varietal</p>
      <h1 class="font-display text-5xl md:text-7xl text-porcelain leading-tight">
        {meta.label}.
      </h1>
      <p class="mt-4 font-display italic text-2xl text-honey-500 max-w-2xl">{meta.tagline}</p>

      <div class="mt-10 grid grid-cols-3 gap-6 max-w-2xl">
        <div>
          <p class="eyebrow mb-1">Brew temp</p>
          <p class="font-mono text-3xl text-porcelain">{meta.brewTemp}</p>
        </div>
        <div>
          <p class="eyebrow mb-1">Steep time</p>
          <p class="font-mono text-3xl text-porcelain">{meta.brewTime}</p>
        </div>
        <div>
          <p class="eyebrow mb-1">Caffeine</p>
          <p class="font-mono text-3xl text-porcelain capitalize">{meta.caffeine}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-end justify-between mb-8 gap-4 border-b border-steep-700 pb-4">
      <h2 class="font-display text-3xl md:text-4xl text-porcelain">What we recommend.</h2>
      <span class="font-mono text-xs text-steep-300">{items.length} review{items.length !== 1 ? 's' : ''}</span>
    </div>
    {items.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {items.map((s) => <SkuCard sku={s} variant="compact"/>)}
      </div>
    ) : (
      <p class="text-steep-300">No SKUs in this varietal yet. We're working on it.</p>
    )}
  </section>

  <section class="border-t border-steep-700 bg-steep-800/40">
    <div class="max-w-4xl mx-auto px-6 py-12">
      <p class="eyebrow mb-3">Other leaves</p>
      <div class="flex flex-wrap gap-2">
        {BROWSABLE_VARIETALS.filter((v) => v !== varietal).map((v) => (
          <a href={`/varietals/${v}/`}
             class="px-4 py-2 border border-steep-700 rounded-sm text-steep-100 no-underline hover:border-honey-500 hover:text-honey-400">
            {VARIETALS[v].label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
