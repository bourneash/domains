---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SKUS, VARIETALS, BROWSABLE_VARIETALS } from '@/lib/affiliate';

const counts = Object.fromEntries(
  BROWSABLE_VARIETALS.map((v) => [v, SKUS.filter((s) => s.varietal === v).length])
);
---
<BaseLayout
  title="Browse by varietal — xxxtea"
  description="Black, green, oolong, white, pu-erh, matcha, herbal, rooibos, chai. Pick a leaf and see what we recommend — and what to skip."
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <p class="eyebrow mb-3">Browse by leaf</p>
    <h1 class="font-display text-5xl md:text-6xl text-porcelain leading-tight">By varietal.</h1>
    <p class="mt-4 max-w-2xl text-steep-300">
      Each leaf brews differently. Different temperatures, different times, different patience.
      Every varietal page lists the brewing math and the SKUs we stand behind.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-32">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {BROWSABLE_VARIETALS.map((v) => {
        const meta = VARIETALS[v];
        return (
          <a href={`/varietals/${v}/`} class="card p-6 no-underline block hover:bg-steep-500 transition-colors">
            <div class="flex items-start justify-between mb-3">
              <p class="font-display text-3xl text-porcelain">{meta.label}</p>
              <span class="font-mono text-xs text-steep-300">{counts[v]} pick{counts[v] !== 1 ? 's' : ''}</span>
            </div>
            <p class="text-steep-300 mb-5">{meta.tagline}</p>
            <div class="flex gap-3 text-xs font-mono text-steep-100">
              <span><span class="text-honey-500">Temp</span> {meta.brewTemp}</span>
              <span><span class="text-honey-500">Steep</span> {meta.brewTime}</span>
              <span><span class="text-honey-500">Caffeine</span> {meta.caffeine}</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
