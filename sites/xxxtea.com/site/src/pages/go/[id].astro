---
import { SKUS, amazon } from '@/lib/affiliate';

export function getStaticPaths() {
  return SKUS.map((sku) => ({
    params: { id: sku.id },
    props: { url: amazon(sku.asin ?? sku.searchQuery, sku.id) },
  }));
}

const { url } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content={`0; url=${url}`}>
  <link rel="canonical" href={url}>
  <title>Redirecting…</title>
  <script define:vars={{ url }}>window.location.replace(url);</script>
</head>
<body>
  <p>Taking you to Amazon — <a href={url}>click here if nothing happens.</a></p>
</body>
</html>
