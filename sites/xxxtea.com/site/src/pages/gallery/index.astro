---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Curated photo essay. Each image is a paired slot/caption. Add by appending
// a new entry and dropping the matching `<slug>.webp` + `<slug>-1200.webp` into
// site/public/gallery/.
const essay = [
  { slot: 'bound-pyramid',     caption: 'Bound at the waist. Held there.' },
  { slot: 'shibari-steep',     caption: 'Tied tight. Lowered slow. Held under.' },
  { slot: 'squeezed-silk',     caption: 'A weight you can\'t see. Amber going somewhere.' },
  { slot: 'collar-and-chain',  caption: 'Clipped to chrome. Pulled taut. The collar holds.' },
  { slot: 'slumping-strainer', caption: 'Unlatched. Leaking. Refusing to clean itself up.' },
  { slot: 'suspended-strainer',caption: 'Suspended. Squeezed completely closed. One slow drip.' },
  { slot: 'frayed-ladder-tear',caption: 'A ladder run, spreading slow. The leaves are out.' },
];
---
<BaseLayout
  title="Gallery — xxxtea"
  description="A photo essay. Macro fragrance-ad photography of tea, bags, and the wares that brew them. Shot like a campaign. The reader's brain does the rest."
>
  <section class="max-w-4xl mx-auto px-6 py-20 md:py-28">
    <p class="eyebrow mb-3">Gallery — №01</p>
    <h1 class="font-display text-5xl md:text-7xl text-porcelain leading-[1.02]">
      Bound. Steeped. <span class="italic text-honey-500">Squeezed.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-steep-300 text-lg">
      We pressed it flat. Pulled the string until it bit. Caught the amber drop in the
      moment before it detached. Macro photography of tea bags, infusers, and silk mesh
      under the kind of light nobody wastes on a kitchen object — except us, here, today.
    </p>
  </section>

  <section class="border-y border-steep-700">
    <div class="max-w-7xl mx-auto px-2 md:px-6 py-2 grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-3">
      {essay.map((e, i) => (
        <figure class={`relative group overflow-hidden ${i === 0 ? 'md:col-span-2' : ''}`}>
          <img src={`/gallery/${e.slot}.webp`} alt={e.caption}
               class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
               loading={i < 2 ? 'eager' : 'lazy'} decoding="async"/>
          <figcaption class="absolute inset-x-0 bottom-0 p-5 md:p-8 bg-gradient-to-t from-steep-900/95 via-steep-900/40 to-transparent">
            <p class="font-display italic text-xl md:text-2xl text-porcelain max-w-md">{e.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <p class="eyebrow mb-3">House rules</p>
    <p class="font-display italic text-2xl text-porcelain">
      Every image is shot the same way the cup is poured. Slow. Once. Right.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/reviews/" class="btn-primary">Browse the reviews</a>
      <a href="/brewing/" class="btn-ghost">Read the brewing guide</a>
    </div>
  </section>
</BaseLayout>
