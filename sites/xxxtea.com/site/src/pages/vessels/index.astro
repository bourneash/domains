---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SKUS, FORMS, VESSEL_FORMS } from '@/lib/affiliate';

const counts = Object.fromEntries(
  VESSEL_FORMS.map((f) => [f, SKUS.filter((s) => s.form === f).length])
);
---
<BaseLayout
  title="Browse by vessel — xxxtea"
  description="Kettles, teapots, infusers, matcha sets, accessories. The hardware that turns leaves into a cup."
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <p class="eyebrow mb-3">Browse by ware</p>
    <h1 class="font-display text-5xl md:text-6xl text-porcelain leading-tight">By vessel.</h1>
    <p class="mt-4 max-w-2xl text-steep-300">
      The kettle controls the water. The pot controls the brew. The infuser controls the
      mess. Pick the hardware first — the leaves come easier once the rest is in place.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-32">
    <div class="grid md:grid-cols-2 gap-5">
      {VESSEL_FORMS.map((f) => (
        <a href={`/vessels/${f}/`} class="card p-7 no-underline block hover:bg-steep-500">
          <div class="flex items-start justify-between mb-3">
            <p class="font-display text-3xl text-porcelain">{FORMS[f].label}</p>
            <span class="font-mono text-xs text-steep-300">{counts[f]} pick{counts[f] !== 1 ? 's' : ''}</span>
          </div>
          <p class="text-steep-300">{FORMS[f].tagline}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
