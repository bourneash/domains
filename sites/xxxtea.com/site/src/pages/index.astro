---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkuCard from '@/components/SkuCard.astro';
import { SKUS, BUNDLES, SKU_BY_ID, FORMS, VARIETALS, BROWSABLE_VARIETALS } from '@/lib/affiliate';

const featured = SKUS.slice(0, 6);
const bundleSets = [
  { key: 'ritual',  title: 'The Ritual Setup',     blurb: 'Variable-temp kettle, glass teapot, a properly fragrant black. Everything in place before the first pour.' },
  { key: 'starter', title: 'The Starter Pull',     blurb: 'For the first-timer who wants to find out which leaves they actually keep coming back to. Three boxes, eight tins, no commitment.' },
  { key: 'evening', title: 'The Evening Wind-Down', blurb: 'Caffeine-free, slow-brew, served from the stoneware pot. The mug you sit down with — not the one you fight with.' },
  { key: 'matcha',  title: 'The Ceremony Kit',     blurb: 'A premium tin, a stone-ground daily, and the bamboo whisk that lets you make either one work. Forty seconds, every morning.' },
] as const;

const heroImg = '/hero/bound-pyramid-1600.webp';
---
<BaseLayout
  title="xxxtea — Tea for adults."
  description="Tea for adults. Honest reviews of loose-leaf, pyramid bags, infusers, kettles, teapots — by varietal, by vessel, by brew. Nothing padded."
  ogImage="/og-default.svg"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImg} fetchpriority="high"/>
  </Fragment>

  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-steep-700"
           style="height: min(92vh, 880px); min-height: 580px;">
    <div class="absolute inset-0">
      <img src={heroImg} alt="" class="w-full h-full object-cover drift"
           loading="eager" decoding="async" fetchpriority="high"/>
      <div class="absolute inset-0 bg-gradient-to-r from-steep-900/95 via-steep-900/55 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-steep-900 via-transparent to-steep-900/30"></div>
    </div>
    <div class="relative h-full flex flex-col justify-end pb-20 md:pb-28 max-w-6xl mx-auto px-6">
      <p class="eyebrow mb-4 text-honey-400">xxx · tea</p>
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl leading-[1.02] text-porcelain max-w-3xl">
        Tea for <span class="italic text-honey-500">adults.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg md:text-xl text-steep-100/85 leading-relaxed">
        Loose leaf. Hot water. Patience. Nothing complicated about it — except getting the
        temperature right, the time right, the leaves right, and the vessel right.
        That's what we're here for.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/reviews/" class="btn-primary">Browse reviews</a>
        <a href="/brewing/" class="btn-ghost">Brewing guide</a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="border-b border-steep-700 bg-steep-900">
    <div class="max-w-6xl mx-auto px-6 py-5 grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="border-l border-honey-500 pl-4">
        <p class="font-display text-3xl text-porcelain">{SKUS.length}</p>
        <p class="text-xs text-steep-300 uppercase tracking-widest">SKUs reviewed</p>
      </div>
      <div class="border-l border-honey-500 pl-4">
        <p class="font-display text-3xl text-porcelain">{BROWSABLE_VARIETALS.length}</p>
        <p class="text-xs text-steep-300 uppercase tracking-widest">Varietals covered</p>
      </div>
      <div class="border-l border-honey-500 pl-4">
        <p class="font-display text-3xl text-porcelain">{Object.keys(FORMS).length}</p>
        <p class="text-xs text-steep-300 uppercase tracking-widest">Form factors</p>
      </div>
      <div class="border-l border-honey-500 pl-4">
        <p class="font-display text-3xl text-porcelain">0</p>
        <p class="text-xs text-steep-300 uppercase tracking-widest">Sponsored takes</p>
      </div>
    </div>
  </div>

  <!-- FEATURED -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-10 gap-4">
      <div>
        <p class="eyebrow mb-3">The picks</p>
        <h2 class="font-display text-4xl md:text-5xl text-porcelain">Featured this week.</h2>
      </div>
      <a href="/reviews/" class="hidden md:inline-block btn-ghost text-sm py-2 px-4">All reviews →</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map((s) => <SkuCard sku={s} variant="compact"/>)}
    </div>
    <div class="mt-8 md:hidden">
      <a href="/reviews/" class="btn-ghost w-full text-center justify-center">All reviews →</a>
    </div>
  </section>

  <!-- BUNDLES -->
  <section class="border-y border-steep-700 bg-steep-800/40">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <p class="eyebrow mb-3">Curated kits</p>
      <h2 class="font-display text-4xl md:text-5xl text-porcelain mb-12">Built sets for every cup.</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {bundleSets.map((b) => {
          const items = BUNDLES[b.key].map((id) => SKU_BY_ID[id]).filter(Boolean);
          return (
            <div class="card p-6">
              <h3 class="font-display text-2xl text-porcelain mb-2">{b.title}</h3>
              <p class="text-steep-300 mb-5">{b.blurb}</p>
              <ul class="space-y-2 mb-5">
                {items.map((i) => (
                  <li class="text-sm flex justify-between gap-3 border-b border-steep-700 pb-2">
                    <a href={`/reviews/${i.id}/`} class="text-steep-100 no-underline hover:text-honey-400">{i.name}</a>
                    <span class="font-mono text-xs text-steep-300 shrink-0">{FORMS[i.form].label}</span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-wrap gap-2">
                {items.map((i) => (
                  <a href={`/go/${i.id}`} rel="sponsored noopener" class="btn-ghost text-xs py-2 px-3">{i.name.split(' ')[0]} →</a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- GALLERY TEASER -->
  <section class="relative overflow-hidden border-y border-steep-700">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10 gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">Gallery — №01</p>
          <h2 class="font-display text-4xl md:text-5xl text-porcelain leading-tight">
            Bound. Steeped. <span class="italic text-honey-500">Squeezed.</span>
          </h2>
          <p class="mt-3 text-steep-300">
            We got it into the light. Pressed it flat. Pulled the string until it bit. The fluid
            physics did the rest. Macro photography of tea bags and infusers under the kind of
            attention nobody hands out to a kitchen object.
          </p>
        </div>
        <a href="/gallery/" class="hidden md:inline-block btn-primary text-sm py-2 px-4">Enter gallery →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <a href="/gallery/" class="block aspect-[4/5] overflow-hidden rounded-sm">
          <img src="/gallery/bound-pyramid-1200.webp" alt=""
               class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
               loading="lazy" decoding="async"/>
        </a>
        <a href="/gallery/" class="block aspect-[4/5] overflow-hidden rounded-sm">
          <img src="/gallery/shibari-steep-1200.webp" alt=""
               class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
               loading="lazy" decoding="async"/>
        </a>
        <a href="/gallery/" class="block aspect-[4/5] overflow-hidden rounded-sm">
          <img src="/gallery/squeezed-silk-1200.webp" alt=""
               class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
               loading="lazy" decoding="async"/>
        </a>
        <a href="/gallery/" class="block aspect-[4/5] overflow-hidden rounded-sm">
          <img src="/gallery/collar-and-chain-1200.webp" alt=""
               class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
               loading="lazy" decoding="async"/>
        </a>
      </div>
      <div class="mt-8 md:hidden">
        <a href="/gallery/" class="btn-primary w-full text-center justify-center">Enter gallery →</a>
      </div>
    </div>
  </section>

  <!-- BY VARIETAL -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <div>
        <p class="eyebrow mb-3">Browse by leaf</p>
        <h2 class="font-display text-4xl md:text-5xl text-porcelain leading-tight">
          Black to white. <span class="italic text-honey-500">Pick a leaf.</span>
        </h2>
        <p class="mt-4 text-steep-300 max-w-md">
          Each varietal gets its own page — temperature, steep time, caffeine, the SKUs we
          stand behind, and what the cup actually tastes like.
        </p>
        <a href="/varietals/" class="btn-primary mt-6">All varietals</a>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        {BROWSABLE_VARIETALS.map((v) => {
          const meta = VARIETALS[v];
          return (
            <li>
              <a href={`/varietals/${v}/`}
                 class="block p-3 border border-steep-700 rounded-sm hover:border-honey-500 hover:text-honey-400 no-underline text-steep-100">
                <span class="font-display text-lg">{meta.label}</span>
                <span class="block text-xs text-steep-300 font-mono">{meta.brewTemp} · {meta.brewTime}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- DISCLOSURE -->
  <section class="bg-steep-800 border-t border-steep-700">
    <div class="max-w-3xl mx-auto px-6 py-12 text-center">
      <p class="eyebrow mb-3">House rules</p>
      <p class="font-display italic text-2xl md:text-3xl text-porcelain">
        We steep long. We taste honestly. We tell you exactly what's in the cup — even when the
        bag underdelivers.
      </p>
      <p class="mt-3 text-sm text-steep-300">
        xxxtea earns a small commission when you buy through our links. It costs you nothing and
        keeps the kettle on.
      </p>
    </div>
  </section>
</BaseLayout>
