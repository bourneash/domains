---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkuCard from '@/components/SkuCard.astro';
import { SKUS, FORMS, type Form } from '@/lib/affiliate';

const byForm = (Object.keys(FORMS) as Form[])
  .map((f) => ({ form: f, items: SKUS.filter((s) => s.form === f) }))
  .filter((g) => g.items.length > 0);
---
<BaseLayout
  title="All reviews — xxxtea"
  description="Every loose-leaf, pyramid bag, infuser, kettle, and teapot we've put hands on. Organized by form factor."
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <p class="eyebrow mb-3">The whole shelf</p>
    <h1 class="font-display text-5xl md:text-6xl text-porcelain leading-tight">All reviews.</h1>
    <p class="mt-4 max-w-2xl text-steep-300">
      Every SKU we've reviewed — loose leaf, bags, powders, and the wares that brew them.
      Pick a form factor below or scroll the lot.
    </p>
  </section>

  <div class="max-w-6xl mx-auto px-6 pb-32 lg:flex lg:gap-16 lg:items-start">
    <aside class="hidden lg:block w-52 shrink-0 sticky top-10 self-start pt-2">
      <div class="flex items-center gap-2 mb-6">
        <span class="block w-3 h-px bg-honey-500"></span>
        <p class="font-mono text-[10px] uppercase tracking-widest text-steep-300">Form factor</p>
      </div>
      <ul class="space-y-3">
        {byForm.map((g) => (
          <li>
            <a href={`#form-${g.form}`} class="block no-underline text-steep-100 hover:text-honey-400">
              <span class="font-display text-lg">{FORMS[g.form].label}</span>
              <span class="block font-mono text-xs text-steep-300">{g.items.length} item{g.items.length !== 1 ? 's' : ''}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <div class="flex-1 space-y-16">
      {byForm.map((g) => (
        <section id={`form-${g.form}`}>
          <div class="flex items-end justify-between mb-6 gap-4 border-b border-steep-700 pb-3">
            <div>
              <p class="eyebrow mb-1">{FORMS[g.form].label}</p>
              <h2 class="font-display text-3xl md:text-4xl text-porcelain">{FORMS[g.form].tagline}</h2>
            </div>
            <span class="font-mono text-xs text-steep-300">{g.items.length} SKU{g.items.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {g.items.map((s) => <SkuCard sku={s} variant="compact"/>)}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
