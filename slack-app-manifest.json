{
  "display_information": {
    "name": "Domain Ops",
    "description": "Autonomous ops alerts for all domain projects (americastrikes.com, aliencouncil.com, etc.)",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Domain Ops",
      "always_online": true
    }
  },
  "oauth_config": {
