# The executive image only copies tools/executive and the allowlisted control-plane
# modules. Start from an allowlist: transient scanners, runtime caches,
# credentials, site checkouts, and repository metadata cannot enter the build
# context or race the build while being cleaned up.
**
!tools/
tools/*
!tools/executive/
!tools/executive/**
tools/executive/data/
tools/executive/logs/
!tools/fleet-dashboard/
tools/fleet-dashboard/*
!tools/fleet-dashboard/server/
tools/fleet-dashboard/server/*
!tools/fleet-dashboard/server/eventstore.js
!tools/fleet-dashboard/server/executive.js
!tools/fleet-dashboard/server/changequeue.js
!tools/fleet-dashboard/server/task-routing.js
!tools/fleet-dashboard/server/executive-scorecard.js
!tools/fleet-dashboard/server/executive-snapshot.js
!tools/fleet-dashboard/server/executive-data.js
!tools/fleet-dashboard/server/workflow-engine.js
!tools/fleet-dashboard/server/roles.js
!tools/fleet-dashboard/server/sites.js
!tools/fleet-dashboard/server/git.js
!tools/fleet-dashboard/server/deployhealth.js
!tools/fleet-dashboard/server/execution.js
!tools/fleet-dashboard/server/cron/parse.js
!tools/fleet-dashboard/server/cron/runinfo.js
